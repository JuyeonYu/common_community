<div class="px-6 py-12" data-native="true">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 mb-4 text-sm rounded-xl"
       style="background-color: var(--color-accent-soft); color: var(--color-accent); border: 1px solid var(--color-accent);"><%= alert %></p>
  <% end %>

  <h1 class="text-2xl font-bold mb-6 text-center">로그인</h1>

  <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false },
        class: "w-full flex items-center justify-center gap-3 rounded-lg py-3 px-4 text-sm font-medium",
        style: "background-color: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border);" do %>
    <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
    </svg>
    Google로 로그인
  <% end %>
</div>
