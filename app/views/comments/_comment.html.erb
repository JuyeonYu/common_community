<article id="<%= dom_id(comment) %>"
         class="<%= comment.reply? ? 'ml-8 pl-4' : 'card' %>"
         <%= 'style="border-left: 2px solid var(--color-border-muted);"'.html_safe if comment.reply? %>>
  <header class="flex items-center gap-2 text-xs mb-2" style="color: var(--color-text-muted);">
    <%= link_to profile_path(comment.user), class: "flex items-center gap-2 hover:opacity-80" do %>
      <%= avatar_image(comment.user, class: "h-5 w-5 rounded-full") %>
      <span class="font-medium" style="color: var(--color-text);"><%= comment.user.nickname %></span>
    <% end %>
    <span>·</span>
    <%= relative_time(comment.created_at, with_time: true) %>
  </header>

  <div class="text-sm whitespace-pre-wrap" style="color: var(--color-text);"><%= comment.body %></div>

  <footer class="mt-2 flex items-center gap-3 text-xs">
    <%= render "likes/button", likeable: comment %>

    <% if comment.author?(Current.user) || Current.user&.admin? %>
      <%= link_to "수정", edit_comment_path(comment), class: "hover:underline", style: "color: var(--color-text-muted);" %>
      <%= button_to "삭제", comment_path(comment), method: :delete,
            data: { turbo_confirm: "댓글을 삭제하시겠습니까?" },
            class: "hover:underline cursor-pointer bg-transparent border-0 p-0",
            style: "color: var(--color-danger);",
            form: { class: "inline" } %>
    <% end %>

    <% if Current.user && !comment.author?(Current.user) %>
      <%= link_to "신고", new_report_path(reportable_type: "Comment", reportable_id: comment.id),
            class: "ml-auto hover:underline", style: "color: var(--color-text-subtle);" %>
    <% end %>
  </footer>

  <% unless comment.reply? %>
    <% if Current.user %>
      <%= render "comments/reply_form_wrapper", post: comment.post, parent: comment %>
    <% end %>

    <div id="<%= dom_id(comment, :replies) %>" class="mt-3 space-y-3">
      <%= render comment.replies.published %>
    </div>
  <% end %>
</article>
