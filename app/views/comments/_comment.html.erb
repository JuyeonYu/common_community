<article id="<%= dom_id(comment) %>" class="<%= comment.reply? ? "ml-8 border-l-2 border-gray-100 pl-4" : "rounded-md bg-white border border-gray-200 p-4" %>">
  <header class="flex items-center gap-2 text-xs text-gray-500 mb-2">
    <%= link_to profile_path(comment.user), class: "flex items-center gap-2 hover:text-gray-700" do %>
      <%= avatar_image(comment.user, class: "h-5 w-5 rounded-full") %>
      <span class="font-medium text-gray-700"><%= comment.user.nickname %></span>
    <% end %>
    <span>·</span>
    <time datetime="<%= comment.created_at.iso8601 %>"><%= l comment.created_at, format: :short %></time>
  </header>

  <div class="text-sm text-gray-800 whitespace-pre-wrap"><%= comment.body %></div>

  <footer class="mt-2 flex items-center gap-3 text-xs">
    <%= render "likes/button", likeable: comment %>

    <% if comment.author?(Current.user) || Current.user&.admin? %>
      <%= link_to "수정", edit_comment_path(comment), class: "text-gray-500 hover:text-gray-700" %>
      <%= button_to "삭제", comment_path(comment), method: :delete,
            data: { turbo_confirm: "댓글을 삭제하시겠습니까?" },
            class: "text-red-500 hover:text-red-700 cursor-pointer",
            form: { class: "inline" } %>
    <% end %>

    <% if Current.user && !comment.author?(Current.user) %>
      <%= link_to "신고", new_report_path(reportable_type: "Comment", reportable_id: comment.id),
            class: "ml-auto text-gray-400 hover:text-red-500" %>
    <% end %>
  </footer>

  <% unless comment.reply? %>
    <% if Current.user %>
      <%= render "comments/reply_form_wrapper", post: comment.post, parent: comment %>
    <% end %>

    <div id="<%= dom_id(comment, :replies) %>" class="mt-3 space-y-3">
      <%= render comment.replies.published %>
    </div>
  <% end %>
</article>
