<section class="mt-8">
  <h2 class="text-lg font-semibold mb-4">댓글 <span style="color: var(--color-text-muted);"><%= post.comments.published.count %></span></h2>

  <% if Current.user %>
    <div id="new-comment-form" class="mb-6">
      <%= render "comments/form", post: post, parent: nil %>
    </div>
  <% else %>
    <p class="text-sm mb-6" style="color: var(--color-text-muted);">
      댓글을 작성하려면 <%= link_to "로그인", new_session_path, class: "hover:underline", style: "color: var(--color-link);" %>이 필요합니다.
    </p>
  <% end %>

  <div id="comments" class="space-y-4">
    <%= render post.comments.top_level.published.includes(:user, replies: :user).oldest %>
  </div>
</section>
