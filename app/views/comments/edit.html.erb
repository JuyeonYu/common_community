<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold mb-6">댓글 수정</h1>

  <% if @comment.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-4 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% @comment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @comment, url: comment_path(@comment), method: :patch, class: "space-y-3" do |form| %>
    <%= form.text_area :body, required: true, rows: 4,
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>

    <div class="flex items-center gap-2">
      <%= form.submit "수정",
            class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "취소", @comment.post, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  <% end %>
</div>
