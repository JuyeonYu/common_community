<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold mb-6">댓글 수정</h1>

  <% if @comment.errors.any? %>
    <div class="rounded-xl p-4 mb-4 text-sm"
         style="background-color: var(--color-accent-soft); color: var(--color-accent); border: 1px solid var(--color-accent);">
      <ul class="list-disc list-inside">
        <% @comment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @comment, url: comment_path(@comment), method: :patch, class: "space-y-3" do |form| %>
    <%= form.text_area :body, required: true, rows: 4, class: "input" %>

    <div class="flex items-center gap-2">
      <%= form.submit "수정", class: "btn btn-primary" %>
      <%= link_to "취소", @comment.post, class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
</div>
