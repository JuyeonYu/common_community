<%= form_with model: Comment.new(post: post, parent: parent),
      url: post_comments_path(post),
      data: { turbo_frame: "_top" },
      class: "space-y-2" do |form| %>
  <% if parent %>
    <%= form.hidden_field :parent_id, value: parent.id %>
  <% end %>

  <div data-controller="mention-autocomplete" class="relative">
    <%= form.text_area :body, required: true, rows: parent ? 2 : 3,
          placeholder: parent ? "답글 작성..." : "댓글 작성...",
          class: "input",
          data: {
            mention_autocomplete_target: "input",
            action: "input->mention-autocomplete#onInput keydown->mention-autocomplete#onKeydown"
          } %>
    <div data-mention-autocomplete-target="popup" hidden
         class="absolute z-10 mt-1 w-64 rounded-xl shadow-md"
         style="background-color: var(--color-surface); border: 1px solid var(--color-border);"></div>
    <p class="field-hint">@닉네임을 입력하면 자동완성됩니다.</p>
  </div>

  <%= form.submit (parent ? "답글 등록" : "댓글 등록"), class: "btn btn-primary btn-sm" %>
<% end %>
