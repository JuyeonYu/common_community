<%= form_with model: Comment.new(post: post, parent: parent),
      url: post_comments_path(post),
      data: { turbo_frame: "_top" },
      class: "space-y-2" do |form| %>
  <% if parent %>
    <%= form.hidden_field :parent_id, value: parent.id %>
  <% end %>

  <%= form.text_area :body, required: true, rows: parent ? 2 : 3,
        placeholder: parent ? "답글 작성..." : "댓글 작성...",
        class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>

  <%= form.submit (parent ? "답글 등록" : "댓글 등록"),
        class: "rounded-md bg-blue-600 px-3 py-1.5 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
<% end %>
