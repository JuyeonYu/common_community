<%# 본인 메시지 강조는 own_message_controller(Stimulus)가 처리.
    서버 측에서는 양쪽에 동일 partial을 broadcast하므로 Current.user 의존 금지. %>
<div id="<%= dom_id chat_message %>"
     data-controller="own-message"
     data-own-message-sender-id-value="<%= chat_message.sender_id %>"
     class="flex justify-start">
  <div class="message-bubble max-w-[75%] rounded-2xl px-3.5 py-2 text-sm"
       style="background-color: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);">
    <p class="text-[11px] font-medium mb-0.5" style="color: var(--color-text-muted);">
      <%= chat_message.sender.nickname %>
    </p>
    <p class="whitespace-pre-wrap break-words"><%= chat_message.body %></p>
    <p class="text-[10px] mt-1" style="color: var(--color-text-subtle);">
      <%= l chat_message.created_at, format: :short %>
    </p>
    <div class="own-only mt-1 text-[10px]">
      <% if chat_message.read_check_paid? %>
        <span class="opacity-80">
          <%= chat_message.read_at.present? ? "✓ 읽음 #{l chat_message.read_at, format: :short}" : "안 읽음" %>
        </span>
      <% else %>
        <% rcost = Rails.application.config.x.blackticket.chat_read_receipt_cost %>
        <%= button_to "읽음 확인 −#{rcost}",
              mark_read_red_connect_chat_message_path(chat_message.red_connect_id, chat_message),
              method: :post,
              data: { turbo_confirm: "이 메시지의 읽음 여부를 확인합니다. #{rcost} 크레딧이 차감됩니다." },
              class: "underline cursor-pointer bg-transparent border-0 p-0 opacity-80 hover:opacity-100" %>
      <% end %>
    </div>
  </div>
</div>
