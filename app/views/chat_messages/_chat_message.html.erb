<%# 본인 메시지 강조는 own_message_controller(Stimulus)가 처리.
    서버 측에서는 양쪽에 동일 partial을 broadcast하므로 Current.user 의존 금지. %>
<div id="<%= dom_id chat_message %>"
     data-controller="own-message"
     data-own-message-sender-id-value="<%= chat_message.sender_id %>"
     class="flex justify-start">
  <div class="message-bubble max-w-[75%] rounded-2xl px-3 py-2 text-sm bg-white border border-gray-200 text-gray-900">
    <p class="text-[11px] font-medium text-gray-500 mb-0.5">
      <%= chat_message.sender.nickname.presence || chat_message.sender.name %>
    </p>
    <p class="whitespace-pre-wrap break-words"><%= chat_message.body %></p>
    <p class="text-[10px] mt-1 text-gray-400">
      <%= l chat_message.created_at, format: :short %>
    </p>
  </div>
</div>
