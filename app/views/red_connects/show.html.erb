<% content_for :title, "커넥트: #{@other_user.nickname}" %>

<div class="mx-auto max-w-2xl">
  <header class="card mb-4">
    <div class="flex items-start gap-3">
      <%= avatar_image(@other_user, class: "h-12 w-12 rounded-full") %>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <p class="font-semibold"><%= @other_user.nickname %></p>
          <% if @other_user.age %><span class="text-xs" style="color: var(--color-text-muted);"><%= @other_user.age %>세</span><% end %>
          <span class="text-xs" style="color: var(--color-text-muted);"><%= t("users.residence_area.#{@other_user.residence_area}", default: "") %></span>
        </div>
        <p class="text-xs mt-1" style="color: var(--color-text-muted);">
          <%= @other_user.job_title %>
          <% if @other_user.smoking.present? %>
            · 흡연 <%= t("users.smoking.#{@other_user.smoking}") %>
          <% end %>
        </p>
        <% if @other_user.hobby.present? %>
          <p class="text-xs mt-0.5" style="color: var(--color-accent);"><%= @other_user.hobby %></p>
        <% end %>
      </div>
      <div class="text-right shrink-0">
        <p class="text-xs" style="color: var(--color-text-muted);">
          만료 <%= l @red_connect.expires_at, format: :short %>
        </p>
        <% if @red_connect.active? %>
          <%= button_to "커넥트 종료", red_connect_path(@red_connect), method: :delete,
                data: { turbo_confirm: "정말 종료할까요? 종료된 커넥트는 연장 불가합니다." },
                class: "mt-2 text-xs hover:underline cursor-pointer bg-transparent border-0 p-0",
                style: "color: var(--color-danger);" %>
        <% else %>
          <span class="mt-2 inline-block text-xs" style="color: var(--color-text-subtle);"><%= @red_connect.status %></span>
        <% end %>
        <% if @red_connect.extendable? %>
          <% cost = Rails.application.config.x.blackticket.red_connect_extension_cost %>
          <%= button_to extend_duration_red_connect_path(@red_connect), method: :post,
                data: { turbo_confirm: "커넥트를 1개월 연장합니다. #{cost} 크레딧이 차감됩니다." },
                class: "block mt-1 text-xs hover:underline cursor-pointer bg-transparent border-0 p-0",
                style: "color: var(--color-accent);" do %>
            +1개월 −<%= cost %>
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <%= turbo_stream_from @red_connect %>

  <section id="<%= dom_id @red_connect, :messages %>"
           class="space-y-2 mb-4 max-h-[60vh] overflow-y-auto p-3 rounded-xl"
           style="background-color: var(--color-surface-muted);">
    <% if @chat_messages.any? %>
      <%= render @chat_messages %>
    <% else %>
      <p class="text-sm text-center py-4" style="color: var(--color-text-subtle);">아직 메시지가 없습니다.</p>
    <% end %>
  </section>

  <% if @red_connect.active? %>
    <%= render "form", red_connect: @red_connect, chat_message: @chat_message %>

    <details class="mt-6">
      <summary class="text-xs cursor-pointer hover:opacity-80" style="color: var(--color-text-muted);"><%= t(".downvote.summary") %></summary>
      <%= form_with url: red_connect_downvote_path(@red_connect), method: :post, class: "mt-3 space-y-2" do %>
        <div class="space-y-1 text-sm">
          <% %w[false_info abusive incompatible].each do |val| %>
            <label class="flex items-center gap-2">
              <%= radio_button_tag :kind, val, false, required: true %>
              <span><%= t(".downvote.kinds.#{val}") %></span>
            </label>
          <% end %>
        </div>
        <%= text_area_tag :comment, nil, rows: 2, maxlength: 500,
              placeholder: t(".downvote.comment_placeholder"), class: "input" %>
        <%= submit_tag t(".downvote.submit"),
              data: { turbo_confirm: t(".downvote.confirm") },
              class: "btn btn-primary btn-sm" %>
      <% end %>
    </details>
  <% else %>
    <p class="text-sm text-center" style="color: var(--color-text-muted);">종료된 커넥트입니다.</p>
  <% end %>
</div>
