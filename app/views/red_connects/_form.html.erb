<div id="chat_form">
  <%= form_with model: chat_message, url: red_connect_chat_messages_path(red_connect),
        class: "flex items-end gap-2" do |form| %>
    <%= form.text_area :body, rows: 2, maxlength: 1000, required: true,
          placeholder: "메시지 (이미지·이미지 URL 불가)",
          class: "input flex-1 resize-none" %>
    <%= form.submit "보내기", class: "btn btn-primary" %>
  <% end %>
</div>
