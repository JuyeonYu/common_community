<article class="rounded-md bg-white border border-gray-200 p-5 hover:border-gray-300">
  <header class="flex items-center gap-2 text-xs text-gray-500 mb-2">
    <%= link_to profile_path(post.user), class: "flex items-center gap-2 hover:text-gray-700" do %>
      <%= avatar_image(post.user, class: "h-5 w-5 rounded-full") %>
      <span class="font-medium text-gray-700"><%= post.user.name %></span>
    <% end %>
    <span>·</span>
    <time datetime="<%= post.created_at.iso8601 %>"><%= l post.created_at, format: :short %></time>
  </header>

  <div class="flex items-center gap-2 text-xs mb-1">
    <%= link_to post.board.name, board_path(post.board),
          class: "px-1.5 py-0.5 bg-gray-100 text-gray-700 rounded hover:bg-gray-200" %>
    <% if post.prefix.present? %>
      <span class="text-gray-500">[<%= post.prefix %>]</span>
    <% end %>
  </div>

  <h2 class="text-lg font-semibold mb-1">
    <%= link_to post.title, post, class: "hover:underline" %>
  </h2>

  <% if post.tags.any? %>
    <div class="mt-2 flex flex-wrap gap-1">
      <% post.tags.each do |tag| %>
        <%= link_to "##{tag.name}", tag_path(tag),
              class: "text-xs text-blue-600 hover:underline" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-2">
    <%= render "likes/button", likeable: post %>
  </div>
</article>
