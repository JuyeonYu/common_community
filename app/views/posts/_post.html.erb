<article class="card hover:opacity-95 transition-opacity">
  <header class="flex items-center gap-2 text-xs mb-2" style="color: var(--color-text-muted);">
    <%= link_to profile_path(post.user), class: "flex items-center gap-2 hover:opacity-80" do %>
      <%= avatar_image(post.user, class: "h-5 w-5 rounded-full") %>
      <span class="font-medium" style="color: var(--color-text);"><%= post.user.nickname %></span>
    <% end %>
    <span>·</span>
    <time datetime="<%= post.created_at.iso8601 %>"><%= l post.created_at, format: :short %></time>
  </header>

  <h2 class="text-lg font-semibold mb-1">
    <%= link_to post.title, post, class: "hover:underline" %>
  </h2>

  <% if post.tags.any? %>
    <div class="mt-2 flex flex-wrap gap-1">
      <% post.tags.each do |tag| %>
        <%= link_to "##{tag.name}", tag_path(tag),
              class: "text-xs hover:underline",
              style: "color: var(--color-accent);" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-3">
    <%= render "likes/button", likeable: post %>
  </div>
</article>
