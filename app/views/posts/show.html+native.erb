<div class="px-4 py-3" data-native="true">
  <article>
    <h1 class="text-xl font-bold mb-2"><%= @post.title %></h1>

    <div class="flex items-center gap-2 text-xs text-gray-500 mb-4">
      <%= avatar_image(@post.user, class: "h-5 w-5 rounded-full") %>
      <span class="font-medium text-gray-700"><%= @post.user.name %></span>
      <span>·</span>
      <time><%= l @post.created_at, format: :short %></time>
      <span>·</span>
      <span>조회 <%= @post.views_count %></span>
    </div>

    <% if @post.tags.any? %>
      <div class="mb-4 flex flex-wrap gap-1">
        <% @post.tags.each do |tag| %>
          <span class="text-xs text-blue-600">#<%= tag.name %></span>
        <% end %>
      </div>
    <% end %>

    <div class="trix-content prose max-w-none text-base">
      <%= @post.body %>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-100">
      <%= render "likes/button", likeable: @post %>
    </div>
  </article>

  <div class="mt-3 flex items-center gap-2 text-sm">
    <% if @post.author?(Current.user) || Current.user&.admin? %>
      <%= link_to "수정", edit_post_path(@post), class: "text-blue-600" %>
      <%= button_to "삭제", post_path(@post), method: :delete,
            data: { turbo_confirm: "정말 삭제하시겠습니까?" },
            class: "text-red-600" %>
    <% end %>
    <% if Current.user && !@post.author?(Current.user) %>
      <%= link_to "신고", new_report_path(reportable_type: "Post", reportable_id: @post.id),
            class: "ml-auto text-gray-400" %>
    <% end %>
  </div>

  <%= render "comments/section", post: @post %>
</div>
