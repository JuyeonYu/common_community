<div class="mx-auto max-w-3xl">
  <% if flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-700 rounded-md text-sm"><%= flash[:notice] %></p>
  <% end %>

  <article class="rounded-md bg-white border border-gray-200 p-6">
    <header class="mb-6">
      <h1 class="text-3xl font-bold mb-3"><%= @post.title %></h1>

      <div class="flex items-center gap-2 text-sm text-gray-500">
        <%= link_to profile_path(@post.user), class: "flex items-center gap-2 hover:text-gray-700" do %>
          <%= avatar_image(@post.user, class: "h-6 w-6 rounded-full") %>
          <span class="font-medium text-gray-700"><%= @post.user.nickname %></span>
        <% end %>
        <span>·</span>
        <time datetime="<%= @post.created_at.iso8601 %>"><%= l @post.created_at, format: :default %></time>
        <span>·</span>
        <span>조회 <%= @post.views_count %></span>
      </div>

      <% if @post.tags.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% @post.tags.each do |tag| %>
            <%= link_to "##{tag.name}", tag_path(tag),
                  class: "text-sm text-blue-600 hover:underline" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <div class="trix-content prose max-w-none">
      <%= @post.body %>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-100">
      <%= render "likes/button", likeable: @post %>
    </div>
  </article>

  <div class="mt-4 flex items-center gap-2 text-sm">
    <% if @post.author?(Current.user) || Current.user&.admin? %>
      <%= link_to "수정", edit_post_path(@post),
            class: "rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50" %>
      <%= button_to "삭제", post_path(@post), method: :delete,
            data: { turbo_confirm: "정말 삭제하시겠습니까?" },
            class: "rounded-md border border-red-300 px-3 py-1.5 text-red-600 hover:bg-red-50" %>
    <% end %>

    <% if Current.user && !@post.author?(Current.user) %>
      <%= link_to "신고", new_report_path(reportable_type: "Post", reportable_id: @post.id),
            class: "ml-auto text-xs text-gray-400 hover:text-red-500" %>
    <% end %>
  </div>

  <%= render "comments/section", post: @post %>

  <div class="mt-6">
    <%= link_to "← 피드로", posts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
</div>
