<div class="mx-auto max-w-3xl">
  <% if flash[:notice] %>
    <p class="py-2 px-3 mb-4 text-sm rounded-xl"
       style="background-color: var(--color-surface-muted); color: var(--color-success);"><%= flash[:notice] %></p>
  <% end %>

  <article class="card" style="padding: 1.5rem;">
    <header class="mb-6">
      <h1 class="text-3xl font-bold mb-3"><%= @post.title %></h1>

      <div class="flex items-center gap-2 text-sm" style="color: var(--color-text-muted);">
        <%= link_to profile_path(@post.user), class: "flex items-center gap-2 hover:opacity-80" do %>
          <%= avatar_image(@post.user, class: "h-6 w-6 rounded-full") %>
          <span class="font-medium" style="color: var(--color-text);"><%= @post.user.nickname %></span>
        <% end %>
        <span>·</span>
        <time datetime="<%= @post.created_at.iso8601 %>"><%= l @post.created_at, format: :default %></time>
        <span>·</span>
        <span>조회 <%= @post.views_count %></span>
      </div>

      <% if @post.tags.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% @post.tags.each do |tag| %>
            <%= link_to "##{tag.name}", tag_path(tag),
                  class: "text-sm hover:underline", style: "color: var(--color-link);" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <div class="trix-content prose max-w-none">
      <%= @post.body %>
    </div>

    <div class="mt-6 pt-4" style="border-top: 1px solid var(--color-border-muted);">
      <%= render "likes/button", likeable: @post %>
    </div>
  </article>

  <div class="mt-4 flex items-center gap-2 text-sm">
    <% if @post.author?(Current.user) || Current.user&.admin? %>
      <%= link_to "수정", edit_post_path(@post), class: "btn btn-secondary btn-sm" %>
      <%= button_to "삭제", post_path(@post), method: :delete,
            data: { turbo_confirm: "정말 삭제하시겠습니까?" },
            class: "btn btn-sm",
            style: "background-color: var(--color-surface); color: var(--color-danger); border: 1px solid var(--color-danger);" %>
    <% end %>

    <% if Current.user && !@post.author?(Current.user) %>
      <%= link_to "신고", new_report_path(reportable_type: "Post", reportable_id: @post.id),
            class: "ml-auto text-xs hover:underline", style: "color: var(--color-text-subtle);" %>
    <% end %>
  </div>

  <%= render "comments/section", post: @post %>

  <div class="mt-6">
    <%= link_to "← 피드로", posts_path, class: "btn btn-ghost btn-sm" %>
  </div>
</div>
