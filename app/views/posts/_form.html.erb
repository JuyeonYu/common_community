<%= form_with model: post, class: "space-y-5" do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
      <p class="font-medium mb-1">저장하지 못했습니다:</p>
      <ul class="list-disc list-inside">
        <% post.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "제목", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :title, required: true, maxlength: 200,
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <div>
    <%= form.label :body, "본문", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.rich_text_area :body, class: "block w-full" %>
  </div>

  <div>
    <%= form.label :tag_names, "태그", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :tag_names, value: post.tag_names, placeholder: "콤마(,)로 구분",
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    <p class="mt-1 text-xs text-gray-500">예: rails, hotwire, 한글태그</p>
  </div>

  <div class="flex items-center gap-2">
    <%= form.submit (post.persisted? ? "수정" : "등록"),
          class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500" %>
    <%= link_to "취소", (post.persisted? ? post : posts_path),
          class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
