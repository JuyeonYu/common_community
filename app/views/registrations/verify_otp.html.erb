<div class="mx-auto max-w-md py-12">
  <h1 class="text-2xl font-bold mb-2">이메일 인증</h1>
  <% pending_email = (session[:signup_attrs] || {})["email_address"] %>
  <p class="text-sm text-gray-500 mb-6">
    <strong><%= pending_email %></strong>로 발송된 6자리 코드를 입력해주세요.
  </p>

  <% if flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-4 text-red-700 rounded-md text-sm"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: confirm_signup_path(token: params[:token]), class: "space-y-4" do |form| %>
    <div>
      <%= form.label :code, "인증 코드", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :code, required: true, maxlength: EmailOtp::CODE_LENGTH,
            inputmode: "numeric", autocomplete: "one-time-code",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-center text-xl tracking-widest focus:outline-blue-600" %>
    </div>

    <%= form.submit "확인 후 가입 완료",
          class: "w-full rounded-md bg-gray-900 px-4 py-2.5 text-white text-sm font-medium hover:bg-gray-800 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-xs text-gray-500 text-center">
    코드를 받지 못하셨나요? <%= link_to "다시 시도", signup_path(token: params[:token]), class: "underline" %>
  </p>
</div>
