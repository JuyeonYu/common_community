<div class="mx-auto max-w-md py-12">
  <h1 class="text-2xl font-bold mb-2">Black Ticket 가입</h1>
  <p class="text-sm text-gray-500 mb-6">
    <strong><%= @invitation.inviter.name %></strong>님의 초대로 진행합니다.
  </p>

  <% if flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-4 text-red-700 rounded-md text-sm"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: signup_path(token: @invitation.token), scope: :user, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, "이름", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, value: @user_attrs[:name], required: true, maxlength: 30,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>

    <div>
      <%= form.label :birthdate, "생년월일", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.date_field :birthdate, value: @user_attrs[:birthdate], required: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
      <p class="mt-1 text-xs text-gray-500">만 <%= User::ADULT_AGE %>세 이상만 가입 가능</p>
    </div>

    <div>
      <%= form.label :phone, "휴대폰 번호", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.telephone_field :phone, value: @user_attrs[:phone], required: true,
            placeholder: "010-0000-0000",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>

    <div>
      <%= form.label :email_address, "이메일", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.email_field :email_address, value: @user_attrs[:email_address], required: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
      <p class="mt-1 text-xs text-gray-500">인증 코드가 이 이메일로 발송됩니다.</p>
    </div>

    <%= form.submit "인증 코드 받기",
          class: "w-full rounded-md bg-gray-900 px-4 py-2.5 text-white text-sm font-medium hover:bg-gray-800 cursor-pointer" %>
  <% end %>
</div>
