<%= turbo_stream_from Current.user, :notifications %>

<div class="px-4 py-3" data-native="true">
  <h1 class="text-xl font-bold mb-4">알림</h1>

  <% if @notifications.any? %>
    <div id="notifications_list" class="space-y-2">
      <%= render @notifications %>
    </div>
    <div class="mt-6 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div id="notifications_list" class="text-center text-gray-500 py-8">
      받은 알림이 없습니다.
    </div>
  <% end %>
</div>
