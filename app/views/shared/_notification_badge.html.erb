<% if user %>
  <% unread_count = user.notifications.unread.size %>
  <%= link_to notifications_path, class: "relative text-lg leading-none", title: "알림" do %>
    🔔
    <% if unread_count.positive? %>
      <span class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full text-[10px] font-medium px-1.5 py-0.5 leading-none">
        <%= unread_count > 99 ? "99+" : unread_count %>
      </span>
    <% end %>
  <% end %>
<% end %>
