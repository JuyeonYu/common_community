<% if user %>
  <% unread = user.total_unread_messages_count %>
  <%= link_to conversations_path, class: "relative text-lg leading-none", title: "쪽지" do %>
    💬
    <% if unread.positive? %>
      <span class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full text-[10px] font-medium px-1.5 py-0.5 leading-none">
        <%= unread > 99 ? "99+" : unread %>
      </span>
    <% end %>
  <% end %>
<% end %>
