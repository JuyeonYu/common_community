<%# 페이지 전역 flash 영역 — 매 페이지 자체 alert 렌더와 무관하게 layout 레벨에서 노출.
    alert 본문에 "크레딧이 부족" 키워드가 포함되면 즉시 충전 CTA를 함께 노출. %>
<% if (alert = flash[:alert]).present? %>
  <% credit_short = alert.to_s.include?("크레딧이 부족") %>
  <div class="container mx-auto mt-3 px-5">
    <div class="rounded-xl px-4 py-3 text-sm flex items-center justify-between gap-3"
         style="background-color: var(--color-accent-soft); color: var(--color-accent); border: 1px solid var(--color-accent);">
      <span><%= alert %></span>
      <% if credit_short && Current.user %>
        <%= link_to "크레딧 충전 →", new_credit_purchase_path,
              class: "btn btn-primary btn-sm shrink-0" %>
      <% end %>
    </div>
  </div>
<% end %>
<% if (notice = flash[:notice]).present? %>
  <div class="container mx-auto mt-3 px-5">
    <div class="rounded-xl px-4 py-3 text-sm"
         style="background-color: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0;">
      <%= notice %>
    </div>
  </div>
<% end %>
