<%# locals: conversation, viewer %>
<% other = conversation.other_for(viewer) %>
<% last_message = conversation.messages.status_visible.recent.first %>
<% unread = conversation.unread_count_for(viewer) %>
<article id="<%= dom_id(conversation) %>"
         class="rounded-md border border-gray-200 bg-white hover:border-gray-300">
  <%= link_to conversation_path(conversation), class: "block p-4" do %>
    <div class="flex items-start gap-3">
      <%= avatar_image(other, class: "h-10 w-10 rounded-full") %>
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline justify-between gap-2">
          <span class="font-medium truncate"><%= other.name %></span>
          <% if last_message %>
            <time class="text-xs text-gray-500 shrink-0">
              <%= l last_message.created_at, format: :short %>
            </time>
          <% end %>
        </div>
        <% if last_message %>
          <p class="text-sm text-gray-600 truncate mt-1">
            <% if last_message.body.present? %>
              <%= last_message.body %>
            <% else %>
              [이미지]
            <% end %>
          </p>
        <% else %>
          <p class="text-sm text-gray-400 mt-1">아직 메시지가 없습니다.</p>
        <% end %>
      </div>
      <% if unread.positive? %>
        <span class="bg-red-500 text-white rounded-full text-xs px-2 py-0.5 shrink-0">
          <%= unread > 99 ? "99+" : unread %>
        </span>
      <% end %>
    </div>
  <% end %>
</article>
