<%= turbo_stream_from Current.user, :conversations %>

<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">쪽지함</h1>
    <%= link_to "차단 관리", blocks_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <% if flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-700 rounded-md text-sm"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-4 text-red-700 rounded-md text-sm"><%= flash[:alert] %></p>
  <% end %>

  <div id="conversations_list" class="space-y-2">
    <%= render @conversations, viewer: Current.user %>
  </div>

  <% if @conversations.empty? %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      받은 쪽지가 없습니다.
    </div>
  <% else %>
    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
