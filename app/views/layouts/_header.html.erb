<% return if turbo_native_app? %>

<header class="sticky top-0 z-30 backdrop-blur"
        style="background-color: color-mix(in srgb, var(--color-bg) 92%, transparent); border-bottom: 1px solid var(--color-border);">
  <div class="px-4 sm:px-5 py-2.5 flex items-center gap-3">
    <%# 모바일 햄버거 — 사이드바 열기 (활성 사용자만 사이드바 노출) %>
    <% if Current.user&.active? %>
      <button type="button" class="lg:hidden p-1 -ml-1"
              data-action="click->sidebar#open"
              style="color: var(--color-text);"
              aria-label="메뉴 열기">
        <%= icon :menu, class: "h-6 w-6" %>
      </button>
    <% end %>

    <%# 모바일 워드마크 (데스크탑은 사이드바에 있음) %>
    <%= link_to "BlackTicket", root_path,
          class: "lg:hidden font-wordmark text-lg",
          style: "color: var(--color-text);" %>

    <%# 데스크탑 검색 — 사이드바 자리 확보 위해 좌측 패딩 %>
    <% if Current.user&.active? %>
      <%= form_with url: posts_path, method: :get,
            class: "hidden md:block flex-1 max-w-md lg:ml-2",
            data: { turbo_frame: "_top" } do |form| %>
        <%= form.search_field :q, value: params[:q], placeholder: "글 검색", class: "input py-1.5" %>
      <% end %>
    <% end %>

    <div class="flex-1"></div>

    <nav class="flex items-center gap-3 text-sm" style="color: var(--color-text-muted);">
      <% if Current.user&.active? %>
        <%= turbo_stream_from Current.user, :notifications %>
        <div id="notification_badge">
          <%= render "shared/notification_badge", user: Current.user %>
        </div>

        <%= link_to history_profile_path(Current.user),
              class: "inline-flex items-center gap-1 rounded-full px-2.5 py-1 hover:opacity-80",
              style: "background-color: var(--color-accent-soft); color: var(--color-accent); border: 1px solid var(--color-accent);",
              title: "내 크레딧 잔액 (클릭하면 이력)" do %>
          <%= icon :coin, class: "h-3.5 w-3.5" %>
          <span class="text-xs font-semibold"><%= number_with_delimiter(Current.user.ticket_credits) %></span>
        <% end %>

        <%= link_to profile_path(Current.user), class: "flex items-center gap-2 hover:opacity-80" do %>
          <%= avatar_image(Current.user, class: "h-8 w-8 rounded-full") %>
        <% end %>
      <% elsif Current.user %>
        <span class="text-xs">활성화 대기</span>
        <%= button_to "로그아웃", session_path, method: :delete, class: "text-xs hover:underline" %>
      <% else %>
        <%= link_to "로그인", new_session_path, class: "hover:underline",
              style: "color: var(--color-accent);" %>
      <% end %>
    </nav>
  </div>
</header>
