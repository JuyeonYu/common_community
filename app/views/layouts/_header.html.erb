<% return if turbo_native_app? %>

<header class="border-b border-gray-200 bg-white">
  <div class="container mx-auto px-5 py-3 flex items-center gap-4">
    <%= link_to "Black Ticket", root_path, class: "text-xl font-bold text-gray-900 shrink-0" %>
    <%= link_to "게시판", boards_path, class: "text-sm text-gray-600 hover:text-gray-900 shrink-0" %>
    <% if Current.user %>
      <%= link_to "초대", invitations_path, class: "text-sm text-gray-600 hover:text-gray-900 shrink-0" %>
    <% end %>

    <%= form_with url: posts_path, method: :get, class: "flex-1 max-w-md", data: { turbo_frame: "_top" } do |form| %>
      <%= form.search_field :q, value: params[:q], placeholder: "글 검색",
            class: "w-full rounded-md border border-gray-300 px-3 py-1.5 text-sm focus:outline-blue-600" %>
    <% end %>

    <nav class="flex items-center gap-4 text-sm shrink-0">
      <% if Current.user %>
        <%= turbo_stream_from Current.user, :notifications %>
        <%= turbo_stream_from Current.user, :messages %>
        <div id="messages_badge">
          <%= render "shared/messages_badge", user: Current.user %>
        </div>
        <div id="notification_badge">
          <%= render "shared/notification_badge", user: Current.user %>
        </div>
        <% if Current.user.admin? %>
          <%= link_to "관리자", admin_dashboard_path, class: "text-red-600 hover:underline" %>
        <% end %>
        <%= link_to profile_path(Current.user), class: "flex items-center gap-2 hover:text-gray-900" do %>
          <%= avatar_image(Current.user, class: "h-8 w-8 rounded-full") %>
          <span class="text-gray-700 hidden sm:inline"><%= Current.user.name %></span>
        <% end %>
        <%= button_to "로그아웃", session_path, method: :delete,
              class: "text-gray-500 underline hover:text-gray-700" %>
      <% else %>
        <%= link_to "로그인", new_session_path, class: "text-blue-600 hover:underline" %>
      <% end %>
    </nav>
  </div>
</header>
