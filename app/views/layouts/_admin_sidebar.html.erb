<aside class="hidden md:block w-48 shrink-0"
       style="border-right: 1px solid var(--color-border); background-color: var(--color-surface);">
  <nav class="p-3 text-sm">
    <h2 class="font-semibold text-xs uppercase tracking-wide mb-2" style="color: var(--color-text-muted);">관리</h2>
    <% items = [
      [ "대시보드",   admin_root_path,         controller.controller_name == "dashboard" && controller.class.module_parent == Admin ],
      [ "사용자",     admin_users_path,        controller.is_a?(Admin::UsersController) ],
      [ "게시물",     admin_posts_path,        controller.is_a?(Admin::PostsController) ],
      [ "시드 이메일", admin_seed_emails_path, controller.is_a?(Admin::SeedEmailsController) ],
      [ "신고",       admin_reports_path,      controller.is_a?(Admin::ReportsController) ]
    ] %>
    <ul class="space-y-1">
      <% items.each do |label, path, current| %>
        <li>
          <%= link_to label, path,
                class: "block rounded px-2 py-1.5 hover:opacity-90",
                style: current ? "background-color: var(--color-accent-soft); color: var(--color-accent); font-weight: 500;" : "color: var(--color-text);" %>
        </li>
      <% end %>
    </ul>
    <p class="mt-4 pt-3" style="border-top: 1px solid var(--color-border-muted);">
      <%= link_to "← 일반 화면", root_path, class: "text-xs hover:underline", style: "color: var(--color-text-muted);" %>
    </p>
  </nav>
</aside>
