<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "블랙티켓" %></title>
    <%# viewport-fit=cover: iOS notch/Dynamic Island 영역까지 활용 (Hotwire Native에서도 동일) %>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <%# 게시판 본문의 숫자가 자동으로 전화/이메일 링크로 변하는 걸 방지 %>
    <meta name="format-detection" content="telephone=no, email=no, address=no">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="BlackTicket">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if Current.user %>
      <meta name="current-user-id" content="<%= Current.user.id %>">
    <% end %>
    <% if (vapid_pk = Rails.application.credentials.dig(:vapid, :public_key)).present? %>
      <meta name="vapid-public-key" content="<%= vapid_pk %>">
    <% end %>

    <%# PortOne V2 통합 정보 — Store ID/Channel Key는 클라 노출 안전. %>
    <% if PortOne.store_id.present? %>
      <meta name="portone-store-id" content="<%= PortOne.store_id %>">
      <% if PortOne.channel_key_identity.present? %>
        <meta name="portone-channel-key-identity" content="<%= PortOne.channel_key_identity %>">
      <% end %>
      <% if PortOne.channel_key_payment.present? %>
        <meta name="portone-channel-key-payment" content="<%= PortOne.channel_key_payment %>">
      <% end %>
      <script src="https://cdn.portone.io/v2/browser-sdk.js" defer></script>
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen antialiased" style="background-color: var(--color-bg); color: var(--color-text);">
    <%= render "layouts/header" %>
    <%= render "shared/flash" %>

    <% if admin_section? %>
      <div class="container mx-auto mt-4 px-5 flex gap-6">
        <%= render "layouts/admin_sidebar" %>
        <main class="flex-1 min-w-0"><%= yield %></main>
      </div>
    <% else %>
      <main class="container mx-auto mt-8 px-5 pb-12">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
