<div class="mx-auto max-w-3xl">
  <%= render "boards/nav", current: @board %>

  <header class="rounded-md bg-white border border-gray-200 p-5 mb-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold mb-1"><%= @board.name %></h1>
        <% if @board.description.present? %>
          <p class="text-sm text-gray-600"><%= @board.description %></p>
        <% end %>
      </div>

      <% if @board.writable_by?(Current.user) %>
        <%= link_to "글쓰기", new_post_path(board_slug: @board.slug),
              class: "rounded-md bg-blue-600 px-3 py-1.5 text-white text-sm font-medium hover:bg-blue-500 shrink-0" %>
      <% end %>
    </div>
  </header>

  <% if @posts.any? %>
    <div class="space-y-4">
      <%= render @posts %>
    </div>

    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      이 게시판에 아직 글이 없습니다.
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "← 게시판 목록", boards_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
</div>
