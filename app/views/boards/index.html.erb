<div class="mx-auto max-w-3xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">게시판</h1>
    <%= link_to "전체 피드", posts_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <% if @boards.any? %>
    <div class="grid sm:grid-cols-2 gap-3">
      <% @boards.each do |board| %>
        <%= link_to board_path(board),
              class: "block rounded-md bg-white border border-gray-200 p-4 hover:border-gray-300" do %>
          <div class="flex items-center justify-between mb-1">
            <h2 class="font-semibold"><%= board.name %></h2>
            <% if board.write_admin_only? %>
              <span class="px-1.5 py-0.5 text-xs bg-red-100 text-red-700 rounded">관리자 글쓰기</span>
            <% end %>
          </div>
          <% if board.description.present? %>
            <p class="text-sm text-gray-600 line-clamp-2"><%= board.description %></p>
          <% end %>
          <p class="text-xs text-gray-400 mt-2"><%= board.posts.published.count %>개 글</p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      게시판이 없습니다.
    </div>
  <% end %>
</div>
