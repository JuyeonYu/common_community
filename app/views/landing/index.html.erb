<% content_for :title, "블랙티켓" %>

<div class="mx-auto max-w-md text-center mt-16 px-5">
  <h1 class="text-3xl font-bold text-gray-900 mb-4">블랙티켓</h1>
  <p class="text-base text-gray-600 mb-2">초대장을 받은 사람만 사용할 수 있습니다.</p>
  <p class="text-sm text-gray-500 mb-8">
    같이 일해본 사람의 추천으로만 합류 가능한 비공개 커뮤니티입니다.
  </p>

  <%= button_to "Google 계정으로 시작하기",
        oauth_callback_path(provider: "google_oauth2"),
        method: :post,
        data: { turbo: false },
        class: "block w-full rounded-md bg-gray-900 text-white py-3 font-medium hover:bg-gray-800 cursor-pointer" %>

  <p class="mt-6 text-xs text-gray-400">
    가입은 누구나 가능하지만, 활성화는 초대 코드가 필요합니다.<br>
    가입 후 코드 입력 화면이 표시됩니다.
  </p>

  <%= link_to "관리자 로그인", new_session_path,
        class: "mt-10 inline-block text-xs text-gray-400 hover:text-gray-600 underline" %>
</div>
