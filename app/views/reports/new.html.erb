<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-2">신고하기</h1>
  <p class="text-sm mb-6" style="color: var(--color-text-muted);">
    부적절한 콘텐츠를 신고합니다. 거짓 신고는 제재 사유가 될 수 있습니다.
  </p>

  <% if @report.errors.any? %>
    <div class="rounded-xl p-4 mb-4 text-sm"
         style="background-color: var(--color-accent-soft); color: var(--color-accent); border: 1px solid var(--color-accent);">
      <ul class="list-disc list-inside">
        <% @report.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @report, url: reports_path, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :reportable_type, @reportable.class.name %>
    <%= hidden_field_tag :reportable_id,   @reportable.id %>

    <div class="card-muted p-3 text-sm">
      <% case @reportable %>
      <% when Post %>
        <p class="font-medium"><%= @reportable.title %></p>
        <p class="text-xs mt-1" style="color: var(--color-text-muted);">글 · <%= @reportable.user.nickname %></p>
      <% when Comment %>
        <p class="line-clamp-2"><%= @reportable.body %></p>
        <p class="text-xs mt-1" style="color: var(--color-text-muted);">댓글 · <%= @reportable.user.nickname %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :reason, "신고 사유", class: "label" %>
      <%= form.text_area :reason, required: true, rows: 4, maxlength: 1_000,
            placeholder: "신고 사유를 구체적으로 작성해주세요.", class: "input" %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.submit "신고", class: "btn btn-primary" %>
      <%= link_to "취소", back_path, class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
</div>
