<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-2">신고하기</h1>
  <p class="text-sm text-gray-500 mb-6">
    부적절한 콘텐츠를 신고합니다. 거짓 신고는 제재 사유가 될 수 있습니다.
  </p>

  <% if @report.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-4 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% @report.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @report, url: reports_path, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :reportable_type, @reportable.class.name %>
    <%= hidden_field_tag :reportable_id,   @reportable.id %>

    <div class="rounded-md bg-gray-50 p-3 text-sm text-gray-700">
      <% case @reportable %>
      <% when Post %>
        <p class="font-medium"><%= @reportable.title %></p>
        <p class="text-xs text-gray-500">글 · <%= @reportable.user.name %></p>
      <% when Comment %>
        <p class="line-clamp-2"><%= @reportable.body %></p>
        <p class="text-xs text-gray-500 mt-1">댓글 · <%= @reportable.user.name %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :reason, "신고 사유", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :reason, required: true, rows: 4, maxlength: 1_000,
            placeholder: "신고 사유를 구체적으로 작성해주세요.",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.submit "신고",
            class: "rounded-md bg-red-600 px-4 py-2 text-white text-sm font-medium hover:bg-red-500 cursor-pointer" %>
      <%= link_to "취소", back_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  <% end %>
</div>
