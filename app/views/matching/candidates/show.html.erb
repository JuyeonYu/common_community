<% content_for :title, @candidate.nickname %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← 매칭 후보 목록", matching_path, class: "btn btn-ghost btn-sm" %>

  <article class="card mt-3" style="padding: 1.5rem;">
    <div class="flex items-start gap-4">
      <%= avatar_image(@candidate, class: "h-24 w-24 rounded-full") %>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-2xl font-bold"><%= @candidate.nickname %></h1>
          <% if @invitation&.boosted? %>
            <span class="chip chip-accent">강력 추천</span>
          <% end %>
        </div>
        <p class="text-sm mt-1" style="color: var(--color-text-muted);">
          <% if @candidate.age %><span><%= @candidate.age %>세</span><% end %>
          <% if @candidate.gender.present? %><span class="ml-2"><%= t("users.gender.#{@candidate.gender}") %></span><% end %>
          <% if @candidate.residence_area.present? %><span class="ml-2"><%= t("users.residence_area.#{@candidate.residence_area}") %></span><% end %>
        </p>
      </div>
    </div>

    <dl class="mt-6 grid grid-cols-2 gap-4 text-sm pt-4"
        style="border-top: 1px solid var(--color-border);">
      <% if @candidate.job_title.present? %>
        <div><dt style="color: var(--color-text-muted);">직무</dt><dd class="mt-1"><%= @candidate.job_title %></dd></div>
      <% end %>
      <% if @candidate.smoking.present? %>
        <div><dt style="color: var(--color-text-muted);">흡연</dt><dd class="mt-1"><%= t("users.smoking.#{@candidate.smoking}") %></dd></div>
      <% end %>
    </dl>

    <% if @candidate.hobby.present? %>
      <p class="mt-4 text-sm" style="color: var(--color-accent);"><%= @candidate.hobby %></p>
    <% end %>

    <% if @candidate.bio.present? %>
      <section class="mt-4 pt-4" style="border-top: 1px solid var(--color-border);">
        <h2 class="text-xs mb-1" style="color: var(--color-text-muted);">자기소개</h2>
        <p class="text-sm whitespace-pre-wrap" style="color: var(--color-text);"><%= @candidate.bio %></p>
      </section>
    <% end %>

    <% if @invitation&.recommendation_comment.present? %>
      <section class="mt-4 pt-4" style="border-top: 1px solid var(--color-border);">
        <h2 class="text-xs mb-1" style="color: var(--color-text-muted);">초대자의 추천</h2>
        <blockquote class="text-sm italic pl-3"
                    style="color: var(--color-text); border-left: 2px solid var(--color-border);">
          "<%= @invitation.recommendation_comment %>"
        </blockquote>
      </section>
    <% end %>
  </article>

  <div class="mt-4">
    <% if @my_pending %>
      <p class="text-sm text-center" style="color: var(--color-text-muted);">
        이번 기수에는 이미 다른 분에게 커넥트 요청을 보냈습니다.
      </p>
    <% else %>
      <%= button_to "커넥트 요청 보내기",
            connect_requests_path(target_id: @candidate.id),
            method: :post,
            data: { turbo_confirm: "이 사람에게 커넥트를 요청할까요? 1기수에 1명만 가능합니다." },
            class: "btn btn-primary w-full" %>
    <% end %>
  </div>
</div>
