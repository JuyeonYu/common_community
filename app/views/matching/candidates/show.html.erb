<% content_for :title, @candidate.nickname %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← 매칭 후보 목록", matching_path, class: "text-sm text-gray-500 hover:text-gray-700" %>

  <article class="mt-3 rounded-md bg-white border border-gray-200 p-6">
    <div class="flex items-start gap-4">
      <%= avatar_image(@candidate, class: "h-24 w-24 rounded-full") %>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-2xl font-bold"><%= @candidate.nickname %></h1>
          <% if @invitation&.boosted? %>
            <span class="text-xs px-2 py-0.5 rounded bg-rose-100 text-rose-700">강력 추천</span>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-1">
          <% if @candidate.age %><span><%= @candidate.age %>세</span><% end %>
          <% if @candidate.gender.present? %><span class="ml-2"><%= t("users.gender.#{@candidate.gender}") %></span><% end %>
          <% if @candidate.residence_area.present? %><span class="ml-2"><%= t("users.residence_area.#{@candidate.residence_area}") %></span><% end %>
        </p>
      </div>
    </div>

    <dl class="mt-6 grid grid-cols-2 gap-4 text-sm border-t pt-4">
      <% if @candidate.job_title.present? %>
        <div><dt class="text-gray-500">직무</dt><dd class="mt-1"><%= @candidate.job_title %></dd></div>
      <% end %>
      <% if @candidate.smoking.present? %>
        <div><dt class="text-gray-500">흡연</dt><dd class="mt-1"><%= t("users.smoking.#{@candidate.smoking}") %></dd></div>
      <% end %>
    </dl>

    <% if @candidate.hobby.present? %>
      <p class="mt-4 text-sm text-blue-600"><%= @candidate.hobby %></p>
    <% end %>

    <% if @candidate.bio.present? %>
      <section class="mt-4 border-t pt-4">
        <h2 class="text-xs text-gray-500 mb-1">자기소개</h2>
        <p class="text-sm text-gray-800 whitespace-pre-wrap"><%= @candidate.bio %></p>
      </section>
    <% end %>

    <% if @invitation&.recommendation_comment.present? %>
      <section class="mt-4 border-t pt-4">
        <h2 class="text-xs text-gray-500 mb-1">초대자의 추천</h2>
        <blockquote class="text-sm text-gray-800 italic border-l-2 border-gray-200 pl-3">
          "<%= @invitation.recommendation_comment %>"
        </blockquote>
      </section>
    <% end %>
  </article>

  <div class="mt-4">
    <% if @my_pending %>
      <p class="text-sm text-gray-500 text-center">
        이번 기수에는 이미 다른 분에게 커넥트 요청을 보냈습니다.
      </p>
    <% else %>
      <%= button_to "커넥트 요청 보내기",
            connect_requests_path(target_id: @candidate.id),
            method: :post,
            data: { turbo_confirm: "이 사람에게 커넥트를 요청할까요? 1기수에 1명만 가능합니다." },
            class: "w-full rounded-md bg-blue-600 px-4 py-2 text-white font-medium hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  </div>
</div>
