<% content_for :title, "이성 매칭" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-2">이성 매칭</h1>
  <p class="text-sm text-gray-500 mb-6">
    같이 일해본 사람의 추천 + 검증된 프로필 기반의 매칭. 활성화하면 매주 매칭 풀에 노출됩니다.
  </p>

  <% if Current.user.matching_active? %>
    <section class="rounded-md bg-green-50 border border-green-200 p-5 mb-6">
      <h2 class="font-semibold text-green-900 mb-1">매칭 활성</h2>
      <p class="text-sm text-green-800 mb-3">
        <% if Current.user.matching_activated_at %>
          <%= l Current.user.matching_activated_at, format: :short %>부터 매칭 풀에 노출 중.
        <% end %>
      </p>
      <%= button_to "잠시 쉬기", matching_path, method: :delete,
            data: { turbo_confirm: "매칭을 일시 중지할까요? 보낸/받은 미수락 요청은 자동 취소됩니다." },
            class: "rounded-md border border-green-300 bg-white px-3 py-1.5 text-sm hover:bg-green-100 cursor-pointer" %>
    </section>

    <% active_connects = Current.user.active_red_connects.includes(:user_a, :user_b) %>
    <% if active_connects.any? %>
      <section class="rounded-md bg-white border border-gray-200 p-5 mb-6">
        <h2 class="font-semibold mb-3">진행 중 커넥트 (<%= active_connects.size %>)</h2>
        <ul class="space-y-2">
          <% active_connects.each do |rc| %>
            <% other = rc.other_user(Current.user) %>
            <li>
              <%= link_to red_connect_path(rc),
                    class: "flex items-center gap-3 rounded-md border border-gray-200 p-2 hover:bg-gray-50" do %>
                <%= avatar_image(other, class: "h-9 w-9 rounded-full") %>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium"><%= other.nickname %></p>
                  <p class="text-xs text-gray-500">만료 <%= l rc.expires_at, format: :short %></p>
                </div>
                <span class="text-xs text-blue-600">채팅 →</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @received_requests.any? %>
      <section class="rounded-md bg-white border border-gray-200 p-5 mb-6">
        <h2 class="font-semibold mb-3">받은 커넥트 요청</h2>
        <ul class="space-y-3">
          <% @received_requests.each do |req| %>
            <li class="flex items-center gap-3 border-b last:border-b-0 pb-3 last:pb-0">
              <%= avatar_image(req.requester, class: "h-10 w-10 rounded-full") %>
              <div class="flex-1 text-sm">
                <p class="font-medium"><%= req.requester.nickname %></p>
                <% if (inv = req.requester.invited_by&.sent_invitations&.find_by(accepted_by_id: req.requester.id)) %>
                  <p class="text-xs text-gray-500 italic">"<%= truncate(inv.recommendation_comment, length: 60) %>"</p>
                <% end %>
              </div>
              <%= button_to "수락", accept_connect_request_path(req), method: :post,
                    class: "rounded-md bg-blue-600 px-3 py-1.5 text-white text-xs cursor-pointer" %>
              <%= button_to "거절", reject_connect_request_path(req), method: :post,
                    class: "rounded-md border border-gray-300 px-3 py-1.5 text-xs cursor-pointer" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @my_pending_request %>
      <section class="rounded-md bg-yellow-50 border border-yellow-200 p-5 mb-6">
        <p class="text-sm">
          이번 기수 요청 송신 완료 — 상대 응답 대기 중
          (<%= @my_pending_request.target.nickname %>)
        </p>
        <%= button_to "요청 취소", connect_request_path(@my_pending_request), method: :delete,
              data: { turbo_confirm: "요청을 취소할까요?" },
              class: "mt-3 rounded-md border border-yellow-400 bg-white px-3 py-1.5 text-xs cursor-pointer" %>
      </section>
    <% end %>

    <section>
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">이번 기수 매칭 후보 (<%= @gen_week %>)</h2>
        <span class="text-xs text-gray-500"><%= @candidates.size %>명</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% @candidates.each do |cand| %>
          <article class="rounded-md bg-white border border-gray-200 p-4">
            <%= link_to matching_candidate_path(cand), class: "flex items-start gap-3 hover:opacity-90" do %>
              <%= avatar_image(cand, class: "h-14 w-14 rounded-full") %>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <p class="font-medium"><%= cand.nickname %></p>
                  <% inv = cand.invited_by&.sent_invitations&.find_by(accepted_by_id: cand.id) %>
                  <% if inv&.boosted? %>
                    <span class="text-xs px-1.5 py-0.5 rounded bg-rose-100 text-rose-700">강력 추천</span>
                  <% end %>
                </div>
                <% if inv && inv.recommendation_comment.present? %>
                  <p class="text-xs text-gray-600 italic mt-1 line-clamp-3">"<%= inv.recommendation_comment %>"</p>
                <% end %>
                <p class="text-[11px] text-blue-600 mt-1">프로필 보기 →</p>
              </div>
            <% end %>
            <% unless @my_pending_request %>
              <%= button_to "커넥트 요청", connect_requests_path(target_id: cand.id), method: :post,
                    data: { turbo_confirm: "이 사람에게 커넥트를 요청할까요? 1기수에 1명만 가능합니다." },
                    class: "mt-3 w-full rounded-md bg-blue-600 px-3 py-1.5 text-white text-xs cursor-pointer" %>
            <% end %>
          </article>
        <% end %>
        <% (MatchingController::POOL_SIZE - @candidates.size).times do %>
          <article class="rounded-md bg-gray-50 border border-dashed border-gray-300 p-4 flex items-center justify-center min-h-[112px]">
            <div class="text-center">
              <div class="h-14 w-14 rounded-full bg-gray-200 mx-auto mb-2"></div>
              <p class="text-xs text-gray-400">매칭 대상 탐색 중…</p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="rounded-md bg-white border border-gray-200 p-5 mb-6">
      <h2 class="font-semibold mb-3">활성화 조건</h2>
      <ul class="space-y-2 text-sm">
        <% User::MATCHING_REQUIRED_FIELDS.each do |field| %>
          <% present = Current.user.public_send(field).present? %>
          <li class="flex items-center gap-2">
            <span class="<%= present ? 'text-green-600' : 'text-gray-300' %>">
              <%= present ? "✓" : "○" %>
            </span>
            <span class="<%= 'text-gray-400 line-through' if present %>">
              <%= I18n.t("activerecord.attributes.user.#{field}", default: field.to_s) %>
            </span>
          </li>
        <% end %>
        <% avatar_present = Current.user.avatar.attached? %>
        <li class="flex items-center gap-2">
          <span class="<%= avatar_present ? 'text-green-600' : 'text-gray-300' %>">
            <%= avatar_present ? "✓" : "○" %>
          </span>
          <span class="<%= 'text-gray-400 line-through' if avatar_present %>">프로필 사진</span>
        </li>
        <% unless Current.user.seed? %>
          <li class="flex items-center gap-2">
            <span class="<%= @has_recommendation ? 'text-green-600' : 'text-gray-300' %>">
              <%= @has_recommendation ? "✓" : "○" %>
            </span>
            <span class="<%= 'text-gray-400 line-through' if @has_recommendation %>">초대자의 추천서</span>
          </li>
        <% end %>
      </ul>

      <% unless @has_recommendation %>
        <div class="mt-4 rounded-md bg-yellow-50 border border-yellow-200 p-3 text-sm">
          <p class="text-yellow-900">
            <strong><%= @accepted_invitation&.inviter&.nickname || "초대자" %></strong>님의 추천서가 아직 없습니다.
          </p>
          <%= button_to "초대자에게 추천서 요청", request_recommendation_invitations_path, method: :post,
                class: "mt-2 rounded-md bg-yellow-600 px-3 py-1.5 text-white text-xs font-medium hover:bg-yellow-500 cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-5 flex items-center gap-3">
        <% if @can_activate %>
          <%= button_to "이성 매칭 시작", enable_matching_path, method: :post,
                class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
          <span class="text-xs text-gray-500">활성화 후 언제든 잠시 쉬기 가능</span>
        <% elsif !@profile_complete %>
          <%= link_to "프로필 채우러 가기", edit_profile_path(Current.user),
                class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500" %>
          <span class="text-xs text-gray-500">필수 항목 <%= @missing_fields.size %>개 누락</span>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
