<% content_for :title, "이성 매칭" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-2">이성 매칭</h1>
  <p class="text-sm text-gray-500 mb-6">
    같이 일해본 사람의 추천 + 검증된 프로필 기반의 매칭. 활성화하면 매주 매칭 풀에 노출됩니다.
  </p>

  <% if Current.user.matching_active? %>
    <section class="rounded-md bg-green-50 border border-green-200 p-5 mb-6">
      <h2 class="font-semibold text-green-900 mb-1">매칭 활성</h2>
      <p class="text-sm text-green-800 mb-3">
        <% if Current.user.matching_activated_at %>
          <%= l Current.user.matching_activated_at, format: :short %>부터 매칭 풀에 노출 중.
        <% end %>
      </p>
      <%= button_to "잠시 쉬기", matching_path, method: :delete,
            data: { turbo_confirm: "매칭을 일시 중지할까요? 보낸/받은 미수락 요청은 자동 취소됩니다." },
            class: "rounded-md border border-green-300 bg-white px-3 py-1.5 text-sm hover:bg-green-100 cursor-pointer" %>
    </section>

    <section class="rounded-md bg-white border border-gray-200 p-5">
      <h2 class="font-semibold mb-2">이번 기수 매칭 후보</h2>
      <p class="text-sm text-gray-500">
        Phase D-2에서 후보 카드 + 커넥트 요청 흐름이 들어옵니다.
      </p>
    </section>
  <% else %>
    <section class="rounded-md bg-white border border-gray-200 p-5 mb-6">
      <h2 class="font-semibold mb-3">활성화 조건</h2>
      <ul class="space-y-2 text-sm">
        <% User::MATCHING_REQUIRED_FIELDS.each do |field| %>
          <% present = Current.user.public_send(field).present? %>
          <li class="flex items-center gap-2">
            <span class="<%= present ? 'text-green-600' : 'text-gray-300' %>">
              <%= present ? "✓" : "○" %>
            </span>
            <span class="<%= 'text-gray-400 line-through' if present %>">
              <%= I18n.t("activerecord.attributes.user.#{field}", default: field.to_s) %>
            </span>
          </li>
        <% end %>
        <% avatar_present = Current.user.avatar.attached? %>
        <li class="flex items-center gap-2">
          <span class="<%= avatar_present ? 'text-green-600' : 'text-gray-300' %>">
            <%= avatar_present ? "✓" : "○" %>
          </span>
          <span class="<%= 'text-gray-400 line-through' if avatar_present %>">프로필 사진</span>
        </li>
      </ul>

      <div class="mt-5 flex items-center gap-3">
        <% if @can_activate %>
          <%= button_to "이성 매칭 시작", enable_matching_path, method: :post,
                class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
          <span class="text-xs text-gray-500">활성화 후 언제든 잠시 쉬기 가능</span>
        <% else %>
          <%= link_to "프로필 채우러 가기", edit_profile_path(Current.user),
                class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500" %>
          <span class="text-xs text-gray-500">필수 항목 <%= @missing_fields.size %>개 누락</span>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
