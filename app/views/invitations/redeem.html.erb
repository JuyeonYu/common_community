<% content_for :title, "초대 코드 입력" %>

<div class="mx-auto max-w-md mt-16 px-5">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">초대 코드 입력</h1>
  <p class="text-sm text-gray-600 mb-6">
    블랙티켓은 초대 코드가 있어야 사용할 수 있습니다.
    초대장을 받았다면 코드를 입력해주세요.
  </p>

  <% if flash[:alert] %>
    <div class="rounded-md bg-red-50 p-3 mb-4 text-sm text-red-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: apply_redemption_invitations_path, method: :post, class: "space-y-3" do |form| %>
    <%= form.text_field :code,
          placeholder: "예: AB2C3D4E",
          maxlength: 8,
          autocomplete: "off",
          autocapitalize: "characters",
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 font-mono tracking-widest text-center focus:outline-blue-600" %>
    <%= form.submit "코드 적용",
          class: "block w-full rounded-md bg-blue-600 text-white py-2 font-medium hover:bg-blue-500 cursor-pointer" %>
  <% end %>

  <%= button_to "로그아웃", session_path, method: :delete,
        class: "mt-6 block w-full text-center text-sm text-gray-500 underline" %>
</div>
