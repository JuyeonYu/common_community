<%# 재귀 트리 노드. locals: node (Hash), root (Boolean) %>
<%
  user        = node[:user]
  children    = node[:children]
  is_root     = local_assigns.fetch(:root, false)
  truncated   = node[:truncated]
  cycle       = node[:cycle]
%>
<div class="<%= is_root ? '' : 'pl-6 ml-3' %>"
     <%= 'style="border-left: 1px solid var(--color-border-muted);"'.html_safe unless is_root %>>
  <div class="inline-flex items-center gap-2 rounded-lg <%= is_root ? 'px-3 py-2' : 'px-2 py-1' %>"
       style="<%= is_root ? 'background-color: var(--color-accent-soft); border: 1px solid var(--color-accent);' : 'background-color: var(--color-surface);' %>">
    <%= avatar_image(user, class: "h-6 w-6 rounded-full") %>
    <%= link_to (user.nickname), profile_path(user),
          class: "text-sm hover:underline #{ 'font-semibold' if is_root }" %>
    <span class="text-xs" style="color: var(--color-text-subtle);">초대 <%= user.invitees.size %></span>
    <% if cycle %>
      <span class="text-xs" style="color: var(--color-warning);">↺ 순환</span>
    <% elsif truncated %>
      <span class="text-xs" style="color: var(--color-text-subtle);">…더보기</span>
    <% end %>
    <% unless is_root %>
      <% inv = user.accepted_invitation %>
      <% if inv && inv.inviter_id == Current.user.id && !inv.recommendation_written? %>
        <%= link_to "추천서 작성", edit_invitation_path(inv),
              class: "text-xs hover:underline", style: "color: var(--color-link);" %>
      <% end %>
    <% end %>
  </div>

  <% if children.any? %>
    <div class="mt-1 space-y-1">
      <% children.each do |child| %>
        <%= render "tree_node", node: child %>
      <% end %>
    </div>
  <% elsif is_root %>
    <p class="mt-2 ml-6 text-xs" style="color: var(--color-text-subtle);">아직 초대해서 활성화된 사람이 없습니다.</p>
  <% end %>
</div>
