<%# 재귀 트리 노드. locals: node (Hash), root (Boolean) %>
<%
  user        = node[:user]
  children    = node[:children]
  is_root     = local_assigns.fetch(:root, false)
  truncated   = node[:truncated]
  cycle       = node[:cycle]
%>
<div class="<%= is_root ? '' : 'pl-6 border-l border-gray-200 ml-3' %>">
  <div class="inline-flex items-center gap-2 rounded-md
              <%= is_root ? 'bg-blue-50 border border-blue-200 px-3 py-2' : 'bg-white px-2 py-1' %>">
    <%= avatar_image(user, class: "h-6 w-6 rounded-full") %>
    <%= link_to (user.nickname.presence || user.name), profile_path(user),
          class: "text-sm hover:underline #{ 'font-semibold' if is_root }" %>
    <span class="text-xs text-gray-400">초대 <%= user.invitees.size %></span>
    <% if cycle %>
      <span class="text-xs text-orange-500">↺ 순환</span>
    <% elsif truncated %>
      <span class="text-xs text-gray-400">…더보기</span>
    <% end %>
    <% unless is_root %>
      <% inv = user.accepted_invitation %>
      <% if inv && inv.inviter_id == Current.user.id && !inv.recommendation_written? %>
        <%= link_to "추천서 작성", edit_invitation_path(inv),
              class: "text-xs text-blue-600 hover:text-blue-800 underline" %>
      <% end %>
    <% end %>
  </div>

  <% if children.any? %>
    <div class="mt-1 space-y-1">
      <% children.each do |child| %>
        <%= render "tree_node", node: child %>
      <% end %>
    </div>
  <% elsif is_root %>
    <p class="mt-2 ml-6 text-xs text-gray-400">아직 초대해서 활성화된 사람이 없습니다.</p>
  <% end %>
</div>
