<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold mb-6">#<%= @tag.name %></h1>

  <% if @posts.any? %>
    <div class="space-y-4">
      <%= render @posts %>
    </div>

    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      이 태그에 글이 없습니다.
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "← 피드로", posts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
</div>
