<div class="px-4 py-3" data-native="true">
  <header>
    <div class="flex items-start gap-3">
      <%= avatar_image(@user, class: "h-16 w-16 rounded-full") %>

      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-xl font-bold">
            <%= @user.nickname %>
          </h1>
          <% if @user.age %>
            <span class="text-sm" style="color: var(--color-text-muted);"><%= @user.age %>세</span>
          <% end %>
        </div>
        <% if @user.job_title.present? %>
          <p class="text-sm mt-1" style="color: var(--color-text);"><%= @user.job_title %></p>
        <% end %>
        <% if @user.bio.present? %>
          <p class="mt-1 text-sm whitespace-pre-wrap" style="color: var(--color-text);"><%= @user.bio %></p>
        <% end %>
      </div>
    </div>

    <% if Current.user&.id == @user.id %>
      <%= link_to "프로필 수정", edit_profile_path(@user),
            class: "mt-3 inline-block text-sm", style: "color: var(--color-link);" %>
    <% end %>
  </header>
</div>
