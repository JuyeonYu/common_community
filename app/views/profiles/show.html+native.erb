<div class="px-4 py-3" data-native="true">
  <header>
    <div class="flex items-start gap-3">
      <%= avatar_image(@user, class: "h-16 w-16 rounded-full") %>

      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-xl font-bold"><%= @user.name %></h1>
          <% if @user.admin? %>
            <span class="px-1.5 py-0.5 rounded text-xs bg-red-100 text-red-700">관리자</span>
          <% end %>
        </div>
        <% if @user.bio.present? %>
          <p class="mt-1 text-sm text-gray-700 whitespace-pre-wrap"><%= @user.bio %></p>
        <% end %>
      </div>
    </div>

    <% if Current.user&.id == @user.id %>
      <%= link_to "프로필 수정", edit_profile_path(@user),
            class: "mt-3 inline-block text-blue-600 text-sm" %>
    <% end %>
  </header>

  <div class="mt-4 grid grid-cols-2 gap-2 text-sm">
    <%= link_to posts_profile_path(@user),
          class: "rounded-md border border-gray-200 p-3" do %>
      <span class="block text-gray-500 text-xs">글</span>
      <span class="block font-semibold mt-1"><%= @user.posts.published.count %></span>
    <% end %>
    <%= link_to comments_profile_path(@user),
          class: "rounded-md border border-gray-200 p-3" do %>
      <span class="block text-gray-500 text-xs">댓글</span>
      <span class="block font-semibold mt-1"><%= @user.comments.published.count %></span>
    <% end %>
  </div>

  <% if @recent_posts.any? %>
    <section class="mt-6">
      <h2 class="font-semibold text-sm text-gray-500 mb-2">최근 글</h2>
      <div class="space-y-2">
        <% @recent_posts.each do |post| %>
          <%= link_to post_path(post), class: "block rounded-md border border-gray-200 p-3" do %>
            <span class="font-medium"><%= post.title %></span>
            <p class="text-xs text-gray-500 mt-1"><%= l post.created_at, format: :short %></p>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
