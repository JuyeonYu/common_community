<div class="mx-auto max-w-3xl">
  <header class="mb-6">
    <%= link_to "← #{@user.nickname}님 프로필", profile_path(@user), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-2xl font-bold mt-2"><%= @user.nickname %>님의 댓글</h1>
  </header>

  <% if @comments.any? %>
    <div class="space-y-3">
      <% @comments.each do |comment| %>
        <article class="rounded-md bg-white border border-gray-200 p-4 text-sm">
          <p class="text-gray-800 whitespace-pre-wrap"><%= comment.body %></p>
          <p class="text-xs text-gray-500 mt-2">
            <%= link_to comment.post.title, comment.post, class: "hover:underline" %>
            · <%= l comment.created_at, format: :short %>
          </p>
        </article>
      <% end %>
    </div>
    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      작성한 댓글이 없습니다.
    </div>
  <% end %>
</div>
