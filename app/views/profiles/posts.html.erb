<div class="mx-auto max-w-3xl">
  <header class="mb-6">
    <%= link_to "← #{@user.nickname}님 프로필", profile_path(@user), class: "btn btn-ghost btn-sm" %>
    <h1 class="text-2xl font-bold mt-2"><%= @user.nickname %>님의 글</h1>
  </header>

  <% if @posts.any? %>
    <div class="space-y-4">
      <%= render @posts %>
    </div>
    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="empty">
      작성한 글이 없습니다.
    </div>
  <% end %>
</div>
