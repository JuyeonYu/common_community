<% content_for :title, "이력" %>

<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold mb-2">이력</h1>
  <p class="text-sm mb-6" style="color: var(--color-text-muted);"><%= @user.nickname %>님의 스코어·크레딧 변동 내역</p>

  <section class="grid grid-cols-2 gap-4 mb-6 text-sm">
    <div class="card" style="padding: 0.75rem;">
      <div style="color: var(--color-text-muted);">현재 티켓 스코어</div>
      <div class="font-semibold text-xl mt-1"><%= @user.ticket_score %></div>
    </div>
    <div class="card" style="padding: 0.75rem;">
      <div style="color: var(--color-text-muted);">현재 티켓 크레딧</div>
      <div class="font-semibold text-xl mt-1"><%= @user.ticket_credits %></div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="font-semibold mb-3">스코어 이력</h2>
    <% if @score_events.any? %>
      <ul class="card" style="padding: 0;">
        <% @score_events.each do |e| %>
          <li class="p-3 text-sm flex items-center justify-between gap-3 not-first:border-t"
              style="border-color: var(--color-border-muted);">
            <div>
              <span class="font-mono" style="color: <%= e.delta.positive? ? 'var(--color-success)' : 'var(--color-danger)' %>;">
                <%= e.delta.positive? ? "+#{e.delta}" : e.delta %>
              </span>
              <span class="ml-2 text-xs" style="color: var(--color-text-muted);"><%= e.reason %></span>
              <% if e.memo.present? %><span class="ml-2" style="color: var(--color-text);">"<%= e.memo %>"</span><% end %>
            </div>
            <span class="text-xs shrink-0" style="color: var(--color-text-muted);"><%= l e.created_at, format: :short %></span>
          </li>
        <% end %>
      </ul>
      <div class="mt-3 text-center text-sm"><%== pagy_nav(@pagy_score) %></div>
    <% else %>
      <p class="text-sm" style="color: var(--color-text-muted);">스코어 변동 이력이 없습니다.</p>
    <% end %>
  </section>

  <section>
    <h2 class="font-semibold mb-3">크레딧 이력</h2>
    <% if @credit_txns.any? %>
      <ul class="card" style="padding: 0;">
        <% @credit_txns.each do |t| %>
          <li class="p-3 text-sm flex items-center justify-between gap-3 not-first:border-t"
              style="border-color: var(--color-border-muted);">
            <div>
              <span class="font-mono" style="color: <%= t.amount.positive? ? 'var(--color-success)' : 'var(--color-danger)' %>;">
                <%= t.amount.positive? ? "+#{t.amount}" : t.amount %>
              </span>
              <span class="ml-2 text-xs" style="color: var(--color-text-muted);"><%= t.kind %></span>
              <% if t.memo.present? %><span class="ml-2" style="color: var(--color-text);">"<%= t.memo %>"</span><% end %>
            </div>
            <span class="text-xs shrink-0" style="color: var(--color-text-muted);"><%= l t.created_at, format: :short %></span>
          </li>
        <% end %>
      </ul>
      <div class="mt-3 text-center text-sm"><%== pagy_nav(@pagy_credit) %></div>
    <% else %>
      <p class="text-sm" style="color: var(--color-text-muted);">크레딧 변동 이력이 없습니다.</p>
    <% end %>
  </section>

  <div class="mt-8">
    <%= link_to "← 프로필로", profile_path(@user), class: "btn btn-ghost btn-sm" %>
  </div>
</div>
