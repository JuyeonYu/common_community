<% content_for :title, "프로필 수정" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">프로필 수정</h1>

  <% if @user.errors.any? %>
    <div class="rounded-xl p-4 mb-4 text-sm"
         style="background-color: var(--color-accent-soft); color: var(--color-accent); border: 1px solid var(--color-accent);">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: profile_path(@user), method: :patch, class: "space-y-5" do |form| %>
    <div data-controller="avatar-picker"
         class="flex items-center gap-4">
      <div class="relative">
        <% has_avatar = @user.avatar.attached? || @user.avatar_url.present? %>
        <% preview_src = @user.avatar.attached? ? url_for(@user.avatar) : @user.avatar_url %>
        <img data-avatar-picker-target="preview"
             src="<%= preview_src %>"
             alt="<%= @user.name %>"
             class="h-24 w-24 rounded-full object-cover <%= 'hidden' unless has_avatar %>"
             style="border: 1px solid var(--color-border); background-color: var(--color-surface-muted);">
        <div data-avatar-picker-target="placeholder"
             class="<%= 'hidden' if has_avatar %> h-24 w-24 rounded-full flex items-center justify-center text-xs"
             style="border: 1px dashed var(--color-border); background-color: var(--color-surface-muted); color: var(--color-text-subtle);">
          사진 없음
        </div>
      </div>
      <div>
        <%= form.file_field :avatar, accept: "image/*",
              data: {
                avatar_picker_target: "input",
                action: "change->avatar-picker#changed"
              },
              class: "hidden" %>
        <button type="button"
                data-action="click->avatar-picker#open"
                class="btn btn-secondary btn-sm">
          사진 변경
        </button>
        <p class="field-hint">JPG/PNG. 저장 버튼을 눌러야 반영됩니다.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :name, "이름", class: "label" %>
        <%= form.text_field :name, required: true, class: "input" %>
      </div>
      <div>
        <%= form.label :nickname, "닉네임 (유일)", class: "label" %>
        <%= form.text_field :nickname, class: "input" %>
      </div>
    </div>

    <div>
      <%= form.label :bio, "자기소개", class: "label" %>
      <%= form.text_area :bio, rows: 3, maxlength: 500, class: "input" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :birth_date, "생년월일", class: "label" %>
        <%= form.date_field :birth_date, class: "input" %>
      </div>
      <div>
        <%= form.label :gender, "성별", class: "label" %>
        <%= form.select :gender,
              [["남성","male"],["여성","female"],["기타","other"]], { include_blank: "선택" },
              class: "input" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :residence_area, "거주지", class: "label" %>
        <%= form.select :residence_area,
              User::RESIDENCE_AREAS.keys.map { |k| [t("users.residence_area.#{k}"), k] },
              { include_blank: "선택" }, class: "input" %>
      </div>
      <div>
        <%= form.label :smoking, "흡연", class: "label" %>
        <%= form.select :smoking,
              [["핌","smokes"],["비흡연","non_smoker"],["가끔","sometimes"]],
              { include_blank: "선택" }, class: "input" %>
      </div>
    </div>

    <div>
      <%= form.label :job_title, "직무 (필수)", class: "label" %>
      <%= form.text_field :job_title, placeholder: "예: 백엔드 개발자", class: "input" %>
    </div>

    <div>
      <%= form.label :hobby, "취미 (해시태그)", class: "label" %>
      <%= form.text_field :hobby,
            placeholder: "러닝, 사진, 컬처 (콤마/공백으로 구분)", class: "input" %>
    </div>

    <fieldset class="rounded-xl p-4"
              style="border: 1px solid var(--color-border);">
      <legend class="text-sm font-semibold px-1" style="color: var(--color-text);">알림 설정</legend>
      <div class="flex items-center gap-2 mt-2">
        <%= form.check_box "notification_preferences[web_push]",
              { checked: @user.notification_preferences["web_push"] != false },
              "true", "false" %>
        <span class="text-sm" style="color: var(--color-text);">브라우저 푸시 알림 받기</span>
      </div>
    </fieldset>

    <div class="flex items-center gap-2">
      <%= form.submit "저장", class: "btn btn-primary" %>
      <%= link_to "취소", profile_path(@user), class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>

  <% if (vapid_pk = Rails.application.credentials.dig(:vapid, :public_key)).present? %>
    <section class="mt-10 pt-6"
             style="border-top: 1px solid var(--color-border);"
             data-controller="push-subscription"
             data-push-subscription-vapid-public-key-value="<%= vapid_pk %>">
      <h2 class="text-lg font-semibold mb-2">브라우저 알림 구독</h2>
      <p class="text-sm mb-3" style="color: var(--color-text-muted);">
        이 브라우저에서 백그라운드 알림을 받으려면 구독을 켜세요. 디바이스마다 별도로 켜야 합니다.
      </p>
      <button type="button"
              data-push-subscription-target="button"
              data-action="push-subscription#toggle"
              class="btn btn-secondary btn-sm">
        브라우저 알림 받기
      </button>
      <p data-push-subscription-target="unsupportedMsg" hidden
         class="text-sm mt-2" style="color: var(--color-text-muted);">
        이 브라우저는 Web Push를 지원하지 않습니다.
      </p>
    </section>
  <% end %>
</div>
