<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">프로필 수정</h1>

  <% if @user.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-4 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: profile_path(@user), method: :patch, class: "space-y-5" do |form| %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">현재 아바타</label>
      <%= avatar_image(@user, class: "h-16 w-16 rounded-full") %>
    </div>

    <div>
      <%= form.label :avatar, "아바타 변경", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.file_field :avatar, accept: "image/*",
            class: "block w-full text-sm text-gray-700" %>
      <p class="mt-1 text-xs text-gray-500">업로드한 이미지가 우선 표시됩니다. 미업로드 시 Google 아바타.</p>
    </div>

    <div>
      <%= form.label :name, "이름", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, required: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>

    <div>
      <%= form.label :bio, "자기소개", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :bio, rows: 4, maxlength: 500,
            placeholder: "자기소개를 입력하세요 (선택)",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.submit "저장",
            class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "취소", profile_path(@user), class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  <% end %>
</div>
