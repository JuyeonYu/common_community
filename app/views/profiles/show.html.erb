<% content_for :title, (@user.nickname.presence || @user.name) %>

<div class="mx-auto max-w-3xl">
  <header class="rounded-md bg-white border border-gray-200 p-6">
    <div class="flex items-start gap-4">
      <%= avatar_image(@user, class: "h-20 w-20 rounded-full") %>

      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-2xl font-bold">
            <%= @user.nickname.presence || @user.name %>
          </h1>
          <% if @user.admin? %>
            <span class="px-2 py-0.5 rounded text-xs bg-red-100 text-red-700">관리자</span>
          <% end %>
          <% if @user.age %>
            <span class="text-sm text-gray-500"><%= @user.age %>세</span>
          <% end %>
          <% if @user.gender.present? %>
            <span class="text-sm text-gray-500"><%= t("users.gender.#{@user.gender}") %></span>
          <% end %>
        </div>

        <% if @user.job_title.present? %>
          <p class="mt-1 text-sm text-gray-700"><%= @user.job_title %></p>
        <% end %>

        <% if @user.residence_area.present? %>
          <p class="text-sm text-gray-500 mt-1"><%= t("users.residence_area.#{@user.residence_area}") %></p>
        <% end %>

        <% if @user.bio.present? %>
          <p class="mt-3 text-sm text-gray-700 whitespace-pre-wrap"><%= @user.bio %></p>
        <% end %>

        <% if @user.hobby.present? %>
          <p class="mt-2 text-sm text-blue-600"><%= @user.hobby %></p>
        <% end %>
      </div>

      <% if Current.user&.id == @user.id %>
        <%= link_to "프로필 수정", edit_profile_path(@user),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <% end %>
    </div>

    <% if Current.user&.id == @user.id || Current.user&.admin? %>
      <dl class="mt-6 grid grid-cols-2 gap-4 text-sm border-t pt-4">
        <div>
          <dt class="text-gray-500">티켓 스코어</dt>
          <dd class="font-semibold mt-1">
            <%= @user.ticket_score %>
            <% if @user.suspended? %>
              <span class="ml-2 px-2 py-0.5 rounded text-xs bg-red-100 text-red-700">정지 중</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-gray-500">티켓 크레딧</dt>
          <dd class="font-semibold mt-1"><%= @user.ticket_credits %></dd>
        </div>
      </dl>
    <% end %>
  </header>
</div>
