<div class="mx-auto max-w-3xl">
  <header class="rounded-md bg-white border border-gray-200 p-6">
    <div class="flex items-start gap-4">
      <%= avatar_image(@user, class: "h-20 w-20 rounded-full") %>

      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-2xl font-bold"><%= @user.name %></h1>
          <% if @user.admin? %>
            <span class="px-2 py-0.5 rounded text-xs bg-red-100 text-red-700">관리자</span>
          <% end %>
        </div>

        <% if @user.bio.present? %>
          <p class="mt-2 text-sm text-gray-700 whitespace-pre-wrap"><%= @user.bio %></p>
        <% end %>

        <p class="mt-2 text-xs text-gray-500">
          가입일 <%= l @user.created_at, format: :default %>
        </p>
      </div>

      <% if Current.user&.id == @user.id %>
        <%= link_to "프로필 수정", edit_profile_path(@user),
              class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
      <% elsif Current.user %>
        <% if Block.exists_between?(Current.user, @user) %>
          <span class="text-xs text-red-500">차단됨</span>
        <% else %>
          <%= button_to "쪽지 보내기", conversations_path,
                params: { with_user_id: @user.id }, method: :post,
                class: "rounded-md bg-blue-600 px-3 py-1.5 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer",
                form: { class: "inline" } %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 text-sm">
      <%= link_to posts_profile_path(@user),
            class: "rounded-md border border-gray-200 p-3 hover:bg-gray-50" do %>
        <span class="block text-gray-500 text-xs">작성한 글</span>
        <span class="block font-semibold mt-1"><%= @user.posts.published.count %></span>
      <% end %>
      <%= link_to comments_profile_path(@user),
            class: "rounded-md border border-gray-200 p-3 hover:bg-gray-50" do %>
        <span class="block text-gray-500 text-xs">작성한 댓글</span>
        <span class="block font-semibold mt-1"><%= @user.comments.published.count %></span>
      <% end %>
    </div>
  </header>

  <section class="mt-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">최근 글</h2>
      <%= link_to "더보기 →", posts_profile_path(@user), class: "text-sm text-blue-600 hover:underline" %>
    </div>
    <% if @recent_posts.any? %>
      <div class="space-y-3">
        <% @recent_posts.each do |post| %>
          <article class="rounded-md bg-white border border-gray-200 p-3">
            <%= link_to post.title, post, class: "font-medium hover:underline" %>
            <p class="text-xs text-gray-500 mt-1"><%= l post.created_at, format: :short %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">아직 작성한 글이 없습니다.</p>
    <% end %>
  </section>

  <section class="mt-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">최근 댓글</h2>
      <%= link_to "더보기 →", comments_profile_path(@user), class: "text-sm text-blue-600 hover:underline" %>
    </div>
    <% if @recent_comments.any? %>
      <div class="space-y-3">
        <% @recent_comments.each do |comment| %>
          <article class="rounded-md bg-white border border-gray-200 p-3 text-sm">
            <p class="line-clamp-2 text-gray-800"><%= comment.body %></p>
            <p class="text-xs text-gray-500 mt-1">
              <%= link_to comment.post.title, comment.post, class: "hover:underline" %>
              · <%= l comment.created_at, format: :short %>
            </p>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">아직 작성한 댓글이 없습니다.</p>
    <% end %>
  </section>
</div>
