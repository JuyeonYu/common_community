<div id="<%= dom_id(likeable, :like_button) %>" class="inline-flex items-center gap-1">
  <% liked = likeable.liked_by?(Current.user) %>
  <% if Current.user %>
    <%= button_to like_url_for(likeable),
          method: liked ? :delete : :post,
          class: "text-base leading-none cursor-pointer #{liked ? 'text-red-500' : 'text-gray-400 hover:text-red-500'}",
          form: { class: "inline" } do %>
      <%= liked ? "♥" : "♡" %>
    <% end %>
  <% else %>
    <span class="text-base leading-none text-gray-400">♡</span>
  <% end %>
  <span class="text-xs text-gray-500"><%= likeable.likes_count %></span>
</div>
