<%= form_with model: @board, url: (@board.persisted? ? admin_board_path(@board) : admin_boards_path),
      class: "space-y-4 max-w-xl bg-white border border-gray-200 rounded-md p-5" do |form| %>
  <% if @board.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% @board.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "이름", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true, maxlength: 30,
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <div>
    <%= form.label :slug, "URL slug (선택, 비우면 이름 기반 자동 생성)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :slug,
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 font-mono text-sm focus:outline-blue-600" %>
    <p class="mt-1 text-xs text-gray-500">영소문자/숫자/_/- 만 가능</p>
  </div>

  <div>
    <%= form.label :description, "설명", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :description, rows: 3, maxlength: 500,
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :position, "순서", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :position, required: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
      <p class="mt-1 text-xs text-gray-500">작을수록 먼저 표시</p>
    </div>

    <div>
      <%= form.label :write_permission, "글쓰기 권한", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :write_permission,
            [ [ "전체 사용자", "everyone" ], [ "관리자 전용", "admin_only" ] ],
            {}, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
  </div>

  <div>
    <%= form.label :allowed_prefixes_text, "말머리 후보 (콤마 또는 줄바꿈 구분)",
          class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :allowed_prefixes_text, rows: 3, value: @board.allowed_prefixes.join(", "),
          placeholder: "질문, 정보, 후기",
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    <p class="mt-1 text-xs text-gray-500">비워두면 이 게시판은 말머리 미사용</p>
  </div>

  <div class="flex items-center gap-2">
    <%= form.submit (@board.persisted? ? "수정" : "생성"),
          class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
    <%= link_to "취소", admin_boards_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
