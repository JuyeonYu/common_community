<% content_for :title, "사용자 관리" %>

<div class="mx-auto max-w-4xl">
  <h1 class="text-2xl font-bold mb-6">사용자</h1>

  <%= form_with url: admin_users_path, method: :get, class: "mb-4" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "이메일 / 이름 / 닉네임 검색",
          class: "input max-w-md" %>
  <% end %>

  <div class="card overflow-x-auto" style="padding: 0;">
    <table class="w-full text-sm">
      <thead style="background-color: var(--color-surface-muted); color: var(--color-text-muted);">
        <tr>
          <th class="text-left px-3 py-2">사용자</th>
          <th class="text-left px-3 py-2">스코어</th>
          <th class="text-left px-3 py-2">크레딧</th>
          <th class="text-left px-3 py-2">상태</th>
          <th class="text-left px-3 py-2">가입일</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |u| %>
          <tr class="not-first:border-t" style="border-color: var(--color-border-muted);">
            <td class="px-3 py-2">
              <div class="font-medium"><%= u.nickname %></div>
              <div class="text-xs" style="color: var(--color-text-muted);"><%= u.email_address %></div>
            </td>
            <td class="px-3 py-2"><%= u.ticket_score %></td>
            <td class="px-3 py-2"><%= u.ticket_credits %></td>
            <td class="px-3 py-2">
              <% if u.suspended? %>
                <span class="chip chip-accent">정지</span>
              <% elsif u.active? %>
                <span class="chip" style="background-color: rgba(22,163,74,0.12); color: var(--color-success); border-color: var(--color-success);">활성</span>
              <% else %>
                <span class="chip">잠금</span>
              <% end %>
              <% if u.seed? %><span class="ml-1 text-xs" style="color: var(--color-link);">seed</span><% end %>
              <% if u.admin? %><span class="ml-1 text-xs" style="color: var(--color-danger);">admin</span><% end %>
            </td>
            <td class="px-3 py-2 text-xs" style="color: var(--color-text-muted);"><%= l u.created_at, format: :short %></td>
            <td class="px-3 py-2 text-right">
              <%= link_to "관리", admin_user_path(u), class: "hover:underline text-xs", style: "color: var(--color-link);" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
