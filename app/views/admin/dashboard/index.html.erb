<% content_for :title, "관리 대시보드" %>

<h1 class="text-2xl font-bold mb-6">관리 대시보드</h1>

<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
  <% [
    [ "사용자",         @user_count,           admin_users_path ],
    [ "매칭 활성 사용자", @active_user_count,    nil ],
    [ "대기 초대장",     @pending_invitation_count, nil ],
    [ "미처리 신고",     @open_report_count,    admin_reports_path ],
    [ "전체 게시물",     @post_count,           admin_posts_path ],
    [ "활성 커넥트",     @active_red_connect_count, nil ]
  ].each do |label, count, path| %>
    <% content = capture do %>
      <div class="text-xs" style="color: var(--color-text-muted);"><%= label %></div>
      <div class="font-semibold text-2xl mt-1"><%= count %></div>
    <% end %>
    <% if path %>
      <%= link_to path, class: "block card hover:opacity-90 transition-opacity" do %><%= content %><% end %>
    <% else %>
      <div class="card"><%= content %></div>
    <% end %>
  <% end %>
</div>

<section class="card">
  <h2 class="font-semibold mb-3">바로가기</h2>
  <ul class="text-sm space-y-2">
    <li><%= link_to "사용자 관리 →", admin_users_path, class: "hover:underline", style: "color: var(--color-link);" %></li>
    <li><%= link_to "게시물 관리 →", admin_posts_path, class: "hover:underline", style: "color: var(--color-link);" %></li>
    <li><%= link_to "시드 이메일 →", admin_seed_emails_path, class: "hover:underline", style: "color: var(--color-link);" %></li>
    <li><%= link_to "신고 처리 →", admin_reports_path, class: "hover:underline", style: "color: var(--color-link);" %></li>
  </ul>
</section>
