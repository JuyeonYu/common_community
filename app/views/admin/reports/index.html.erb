<div class="mx-auto max-w-5xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">신고 관리</h1>

    <nav class="flex gap-2 text-sm">
      <%= link_to "전체", admin_reports_path,
            class: "px-3 py-1 rounded-md hover:opacity-90",
            style: params[:status].blank? ? "background-color: var(--color-surface-muted);" : "" %>
      <% Report.statuses.each_key do |key| %>
        <% label = { "pending" => "보류", "resolved" => "처리됨", "dismissed" => "무시" }[key] %>
        <%= link_to label, admin_reports_path(status: key),
              class: "px-3 py-1 rounded-md hover:opacity-90",
              style: params[:status] == key ? "background-color: var(--color-surface-muted);" : "" %>
      <% end %>
    </nav>
  </div>

  <% if flash[:notice] %>
    <p class="py-2 px-3 mb-4 rounded-xl text-sm"
       style="background-color: var(--color-surface-muted); color: var(--color-success);"><%= flash[:notice] %></p>
  <% end %>

  <% if @reports.any? %>
    <div class="space-y-3">
      <% @reports.each do |report| %>
        <article class="card">
          <header class="flex items-center justify-between text-xs mb-2" style="color: var(--color-text-muted);">
            <span>
              <span class="font-medium" style="color: var(--color-text);"><%= report.reporter.name %></span> 신고 ·
              <time><%= l report.created_at, format: :default %></time>
            </span>
            <% status_style = {
              "pending"   => "background-color: rgba(245,158,11,0.12); color: var(--color-warning); border-color: var(--color-warning);",
              "resolved"  => "background-color: rgba(22,163,74,0.12); color: var(--color-success); border-color: var(--color-success);",
              "dismissed" => "background-color: var(--color-surface-muted); color: var(--color-text-muted); border-color: var(--color-border);"
            }[report.status] %>
            <span class="chip" style="<%= status_style %>">
              <%= { "pending" => "보류", "resolved" => "처리됨", "dismissed" => "무시" }[report.status] %>
            </span>
          </header>

          <div class="rounded-xl p-3 text-sm mb-3"
               style="background-color: var(--color-surface-muted); color: var(--color-text);">
            <% case report.reportable %>
            <% when Post %>
              <p class="font-medium"><%= report.reportable.title %></p>
              <p class="text-xs mt-1" style="color: var(--color-text-muted);">
                글 · <%= report.reportable.user.name %> ·
                <%= link_to "보기", post_path(report.reportable), class: "hover:underline", style: "color: var(--color-link);" %> ·
                상태: <%= report.reportable.status %>
              </p>
            <% when Comment %>
              <p class="line-clamp-3"><%= report.reportable.body %></p>
              <p class="text-xs mt-1" style="color: var(--color-text-muted);">
                댓글 · <%= report.reportable.user.name %> ·
                <%= link_to "원글", post_path(report.reportable.post), class: "hover:underline", style: "color: var(--color-link);" %> ·
                상태: <%= report.reportable.status %>
              </p>
            <% end %>
          </div>

          <p class="text-sm mb-3" style="color: var(--color-text);"><strong>사유:</strong> <%= report.reason %></p>

          <% if report.pending? %>
            <div class="flex gap-2">
              <%= button_to "콘텐츠 숨기기", admin_report_path(report, decision: "hide"), method: :patch,
                    data: { turbo_confirm: "이 콘텐츠를 숨기시겠습니까?" },
                    class: "btn btn-primary btn-sm" %>
              <%= button_to "신고 무시", admin_report_path(report, decision: "dismiss"), method: :patch,
                    class: "btn btn-secondary btn-sm" %>
            </div>
          <% elsif report.resolved? && report.reportable.respond_to?(:hidden?) && report.reportable.hidden? %>
            <%= button_to "콘텐츠 복원", admin_report_path(report, decision: "restore"), method: :patch,
                  data: { turbo_confirm: "이 콘텐츠를 다시 공개하시겠습니까?" },
                  class: "btn btn-sm",
                  style: "background-color: var(--color-surface); color: var(--color-link); border: 1px solid var(--color-link);" %>
          <% end %>

          <% if report.resolved_by %>
            <p class="mt-2 text-xs" style="color: var(--color-text-muted);">
              처리: <%= report.resolved_by.name %> · <%= l report.resolved_at, format: :default %>
            </p>
          <% end %>
        </article>
      <% end %>
    </div>

    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="empty">
      신고가 없습니다.
    </div>
  <% end %>
</div>
