<div class="mx-auto max-w-5xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">신고 관리</h1>

    <nav class="flex gap-2 text-sm">
      <%= link_to "전체", admin_reports_path,
            class: "px-3 py-1 rounded-md #{params[:status].blank? ? 'bg-gray-200' : 'hover:bg-gray-100'}" %>
      <% Report.statuses.each_key do |key| %>
        <% label = { "pending" => "보류", "resolved" => "처리됨", "dismissed" => "무시" }[key] %>
        <%= link_to label, admin_reports_path(status: key),
              class: "px-3 py-1 rounded-md #{params[:status] == key ? 'bg-gray-200' : 'hover:bg-gray-100'}" %>
      <% end %>
    </nav>
  </div>

  <% if flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-700 rounded-md text-sm"><%= flash[:notice] %></p>
  <% end %>

  <% if @reports.any? %>
    <div class="space-y-3">
      <% @reports.each do |report| %>
        <article class="rounded-md bg-white border border-gray-200 p-4">
          <header class="flex items-center justify-between text-xs text-gray-500 mb-2">
            <span>
              <span class="font-medium text-gray-700"><%= report.reporter.name %></span> 신고 ·
              <time><%= l report.created_at, format: :default %></time>
            </span>
            <span class="px-2 py-0.5 rounded text-xs <%= { 'pending' => 'bg-yellow-100 text-yellow-700', 'resolved' => 'bg-green-100 text-green-700', 'dismissed' => 'bg-gray-100 text-gray-600' }[report.status] %>">
              <%= { "pending" => "보류", "resolved" => "처리됨", "dismissed" => "무시" }[report.status] %>
            </span>
          </header>

          <div class="rounded-md bg-gray-50 p-3 text-sm text-gray-700 mb-3">
            <% case report.reportable %>
            <% when Post %>
              <p class="font-medium"><%= report.reportable.title %></p>
              <p class="text-xs text-gray-500 mt-1">
                글 · <%= report.reportable.user.name %> ·
                <%= link_to "보기", post_path(report.reportable), class: "text-blue-600 hover:underline" %> ·
                상태: <%= report.reportable.status %>
              </p>
            <% when Comment %>
              <p class="line-clamp-3"><%= report.reportable.body %></p>
              <p class="text-xs text-gray-500 mt-1">
                댓글 · <%= report.reportable.user.name %> ·
                <%= link_to "원글", post_path(report.reportable.post), class: "text-blue-600 hover:underline" %> ·
                상태: <%= report.reportable.status %>
              </p>
            <% end %>
          </div>

          <p class="text-sm text-gray-800 mb-3"><strong>사유:</strong> <%= report.reason %></p>

          <% if report.pending? %>
            <div class="flex gap-2">
              <%= button_to "콘텐츠 숨기기", admin_report_path(report, decision: "hide"), method: :patch,
                    data: { turbo_confirm: "이 콘텐츠를 숨기시겠습니까?" },
                    class: "rounded-md bg-red-600 px-3 py-1.5 text-white text-xs font-medium hover:bg-red-500" %>
              <%= button_to "신고 무시", admin_report_path(report, decision: "dismiss"), method: :patch,
                    class: "rounded-md border border-gray-300 px-3 py-1.5 text-xs hover:bg-gray-50" %>
            </div>
          <% elsif report.resolved? && report.reportable.respond_to?(:hidden?) && report.reportable.hidden? %>
            <%= button_to "콘텐츠 복원", admin_report_path(report, decision: "restore"), method: :patch,
                  data: { turbo_confirm: "이 콘텐츠를 다시 공개하시겠습니까?" },
                  class: "rounded-md border border-blue-300 px-3 py-1.5 text-blue-600 text-xs hover:bg-blue-50" %>
          <% end %>

          <% if report.resolved_by %>
            <p class="mt-2 text-xs text-gray-500">
              처리: <%= report.resolved_by.name %> · <%= l report.resolved_at, format: :default %>
            </p>
          <% end %>
        </article>
      <% end %>
    </div>

    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      신고가 없습니다.
    </div>
  <% end %>
</div>
