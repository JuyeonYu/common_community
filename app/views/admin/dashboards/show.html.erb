<div>
  <h1 class="text-2xl font-bold mb-6">대시보드</h1>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <% [
         { label: "전체 글",       value: @stats[:posts],            link: posts_path },
         { label: "전체 댓글",     value: @stats[:comments],         link: nil },
         { label: "전체 사용자",   value: @stats[:users],            link: nil },
         { label: "보류 신고",     value: @stats[:pending_reports],  link: admin_reports_path(status: "pending") }
       ].each do |card| %>
      <% wrapper = card[:link] ? :link_to : :div %>
      <%= content_tag wrapper, *(card[:link] ? [ card[:link] ] : []),
            class: "block rounded-md bg-white border border-gray-200 p-4 #{card[:link] ? 'hover:border-gray-300' : ''}" do %>
        <p class="text-sm text-gray-500"><%= card[:label] %></p>
        <p class="mt-2 text-2xl font-bold"><%= card[:value] %></p>
      <% end %>
    <% end %>
  </div>
</div>
