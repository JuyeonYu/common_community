<% content_for :title, "시드 이메일 관리" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">시드 이메일</h1>
  <p class="text-sm mb-6" style="color: var(--color-text-muted);">
    화이트리스트에 등록된 이메일로 첫 Google 로그인 시 초대 코드 없이 자동 활성화됩니다.
    시드 사용자는 가입 즉시 초대장을 발급할 수 있습니다.
  </p>

  <section class="card mb-6">
    <%= form_with model: @seed_email, url: admin_seed_emails_path, class: "flex items-end gap-2" do |form| %>
      <div class="flex-1">
        <%= form.label :email, "이메일", class: "label" %>
        <%= form.email_field :email, required: true, placeholder: "founder@example.com", class: "input" %>
      </div>
      <%= form.submit "추가", class: "btn btn-primary" %>
    <% end %>

    <% if @seed_email.errors.any? %>
      <ul class="mt-3 text-sm list-disc list-inside" style="color: var(--color-danger);">
        <% @seed_email.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    <% end %>
  </section>

  <section>
    <% if @seed_emails.any? %>
      <ul class="card" style="padding: 0;">
        <% @seed_emails.each do |se| %>
          <li class="flex items-center justify-between p-3 not-first:border-t"
              style="border-color: var(--color-border-muted);">
            <div>
              <p class="font-mono text-sm"><%= se.email %></p>
              <p class="text-xs" style="color: var(--color-text-muted);">
                <%= l se.created_at, format: :short %>
                <% if se.created_by %> · <%= se.created_by.name %> <% end %>
              </p>
            </div>
            <%= button_to "삭제", admin_seed_email_path(se), method: :delete,
                  data: { turbo_confirm: "삭제하시겠습니까?" },
                  class: "text-xs underline hover:opacity-80 bg-transparent border-0 cursor-pointer",
                  style: "color: var(--color-danger);" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm" style="color: var(--color-text-muted);">등록된 시드 이메일이 없습니다.</p>
    <% end %>
  </section>
</div>
