<% content_for :title, "시드 이메일 관리" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">시드 이메일</h1>
  <p class="text-sm text-gray-600 mb-6">
    화이트리스트에 등록된 이메일로 첫 Google 로그인 시 초대 코드 없이 자동 활성화됩니다.
    시드 사용자는 가입 즉시 초대장을 발급할 수 있습니다.
  </p>

  <section class="rounded-md bg-white border border-gray-200 p-5 mb-6">
    <%= form_with model: @seed_email, url: admin_seed_emails_path, class: "flex items-end gap-2" do |form| %>
      <div class="flex-1">
        <%= form.label :email, "이메일", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email, required: true,
              placeholder: "founder@example.com",
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
      </div>
      <%= form.submit "추가",
            class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-500 cursor-pointer" %>
    <% end %>

    <% if @seed_email.errors.any? %>
      <ul class="mt-3 text-sm text-red-700 list-disc list-inside">
        <% @seed_email.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    <% end %>
  </section>

  <section>
    <% if @seed_emails.any? %>
      <ul class="divide-y divide-gray-200 rounded-md bg-white border border-gray-200">
        <% @seed_emails.each do |se| %>
          <li class="flex items-center justify-between p-3">
            <div>
              <p class="font-mono text-sm"><%= se.email %></p>
              <p class="text-xs text-gray-500">
                <%= l se.created_at, format: :short %>
                <% if se.created_by %> · <%= se.created_by.name %> <% end %>
              </p>
            </div>
            <%= button_to "삭제", admin_seed_email_path(se), method: :delete,
                  data: { turbo_confirm: "삭제하시겠습니까?" },
                  class: "text-xs text-red-600 hover:text-red-800 underline" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">등록된 시드 이메일이 없습니다.</p>
    <% end %>
  </section>
</div>
