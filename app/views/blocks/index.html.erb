<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">차단 관리</h1>
    <%= link_to "← 쪽지함", conversations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <% if flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-700 rounded-md text-sm"><%= flash[:notice] %></p>
  <% end %>

  <% if @blocks.any? %>
    <div class="space-y-2">
      <% @blocks.each do |block| %>
        <article class="rounded-md border border-gray-200 bg-white p-4 flex items-center gap-3">
          <%= avatar_image(block.blocked, class: "h-10 w-10 rounded-full") %>
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate"><%= block.blocked.name %></p>
            <% if block.reason.present? %>
              <p class="text-xs text-gray-500 truncate"><%= block.reason %></p>
            <% end %>
            <p class="text-xs text-gray-400 mt-1">
              차단일: <%= l block.created_at, format: :default %>
            </p>
          </div>
          <%= button_to "해제", block_path(block), method: :delete,
                data: { turbo_confirm: "차단을 해제하시겠습니까?" },
                class: "text-sm text-blue-600 hover:underline shrink-0" %>
        </article>
      <% end %>
    </div>

    <div class="mt-8 text-center text-sm">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="rounded-md bg-white border border-gray-200 p-8 text-center text-gray-500">
      차단한 사용자가 없습니다.
    </div>
  <% end %>
</div>
