# 이 파일은 git에 들어가도 안전해야 한다. 절대 raw 값 적지 말 것.
# 모든 값은 password manager / ENV / 파일에서 끌어오기.

# Docker Hub 액세스 토큰. 본인 PC에서 한 번:
#   docker login docker.io
# 후, https://hub.docker.com/settings/security 에서 access token을 만들어 환경변수로 넘긴다.
#   export KAMAL_REGISTRY_PASSWORD="dckr_pat_..."
# 또는 1Password 등 사용 시:
#   KAMAL_REGISTRY_PASSWORD=$(op read "op://Private/Docker Hub/token")
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails 자격증명 복호화 키. config/master.key를 직접 읽음.
RAILS_MASTER_KEY=$(cat config/master.key)

# 운영 DB 비밀번호. PG accessory와 Rails 양쪽이 같은 값을 사용한다.
# 강한 랜덤값을 한 번 만들어서 password manager에 저장한 뒤, 환경변수로 export.
#   export JIINDO_DATABASE_PASSWORD="..."
JIINDO_DATABASE_PASSWORD=$JIINDO_DATABASE_PASSWORD
POSTGRES_PASSWORD=$JIINDO_DATABASE_PASSWORD
